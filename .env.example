# Servidor
PORT=3000
SESSION_SECRET=troque-este-segredo

# Produção: URL pública com https (sitemap, canonical, Open Graph)
SITE_URL=https://www.seusite.com.br

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=site_gospel
DB_USER=root
DB_PASS=

# DeepSeek IA (geração automática de matérias)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Serper — Google Imagens (recomendado — 2.500 buscas grátis, sem cartão)
# Plano gratuito NÃO aceita site:instagram.com — use SERPER_PLAN=paid só se tiver upgrade
# 1. Crie conta em https://serper.dev/api-keys
# 2. Copie a API Key
SERPER_API_KEY=
# SERPER_PLAN=paid

# Brave Imagens (fallback — ~US$ 5 grátis/mês ≈ 1000 buscas)
# 1. Crie conta em https://api-dashboard.search.brave.com/
# 2. Plano Free (pede cartão só para verificação, não cobra)
# 3. Copie a API Key
BRAVE_SEARCH_API_KEY=

# Google Imagens (só funciona para contas antigas — fechado para novos clientes)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Bing Imagens (descontinuado pela Microsoft em ago/2025 — legado)
BING_SEARCH_API_KEY=

# Google Indexing API (avisar Google ao publicar / envio em lote)
# 1. Baixe o JSON da conta de serviço no Google Cloud
# 2. Salve como config/google-indexing-key.json (NÃO commite no git)
# 3. Adicione obuxixogospel-indexing@... como PROPRIETÁRIO no Search Console
GOOGLE_INDEXING_KEY_FILE=./config/google-indexing-key.json
