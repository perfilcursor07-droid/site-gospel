<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> | Painel Admin</title>
  <% if (config.favicon) { %><link rel="icon" href="<%= config.favicon %>"><% } %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-topo">
      <div class="sidebar-logo">
        <% if (config.logo) { %><img src="<%= config.logo %>" alt="<%= config.site_nome || 'Site Gospel' %>"><% } else { %>site<strong>gospel</strong><% } %>
      </div>
      <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Abrir menu">☰</button>
    </div>
    <nav id="sidebar-nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/posts">Posts</a>
      <% if (usuarioLogado.papel !== 'usuario') { %>
        <a href="/admin/paginas">Páginas</a>
        <a href="/admin/categorias">Categorias</a>
      <% } %>
      <% if (usuarioLogado.papel === 'administrador') { %>
        <a href="/admin/usuarios">Usuários</a>
        <a href="/admin/configuracoes">Configurações</a>
      <% } %>
      <a href="/" target="_blank">Ver site</a>
      <a href="/logout" class="sair">Sair</a>
    </nav>
  </aside>
  <div class="conteudo">
    <header class="topbar">
      <span class="topbar-titulo"><%= config.site_nome || 'Site Gospel' %></span>
      <span class="topbar-usuario">
        <span class="avatar"><%= usuarioLogado.nome.charAt(0).toUpperCase() %></span>
        <strong><%= usuarioLogado.nome %></strong>
        <span class="papel"><%= usuarioLogado.papel %></span>
      </span>
    </header>
    <main>
      <% mensagens.sucesso.forEach(function (m) { %><div class="alert alert-sucesso"><%= m %></div><% }) %>
      <% mensagens.erro.forEach(function (m) { %><div class="alert alert-erro"><%= m %></div><% }) %>
      <%- body %>
    </main>
  </div>
  <script>
    (function () {
      var btn = document.getElementById('sidebar-toggle');
      var nav = document.getElementById('sidebar-nav');
      if (btn && nav) btn.addEventListener('click', function () { nav.classList.toggle('aberto'); });
    })();
  </script>
</body>
</html>
