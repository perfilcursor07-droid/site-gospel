<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> | Painel Admin</title>
  <% if (config.favicon) { %><link rel="icon" href="<%= config.favicon %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin" id="admin-body">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-topo">
      <a href="/admin" class="sidebar-brand" title="<%= config.site_nome || 'Painel Admin' %>">
        <% if (config.logo) { %>
          <img src="<%= config.logo %>" alt="<%= config.site_nome || 'Site Gospel' %>" class="sidebar-brand-img">
        <% } else { %>
          <span class="sidebar-brand-icon">S</span>
          <span class="sidebar-brand-text">site<strong>gospel</strong></span>
        <% } %>
      </a>
      <button class="sidebar-toggle-mobile" id="sidebar-toggle" aria-label="Abrir menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <% const path = typeof adminPath !== 'undefined' ? adminPath : ''; %>
    <nav id="sidebar-nav" class="sidebar-nav">
      <p class="sidebar-secao">Principal</p>
      <a href="/admin" class="nav-item <%= path === '/' ? 'ativo' : '' %>" data-tooltip="Dashboard">
        <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
        <span class="nav-texto">Dashboard</span>
      </a>
      <a href="/admin/posts" class="nav-item <%= path.startsWith('/posts') ? 'ativo' : '' %>" data-tooltip="Posts">
        <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span>
        <span class="nav-texto">Posts</span>
      </a>
      <% if (usuarioLogado.papel !== 'usuario') { %>
        <a href="/admin/paginas" class="nav-item <%= path.startsWith('/paginas') ? 'ativo' : '' %>" data-tooltip="Páginas">
          <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg></span>
          <span class="nav-texto">Páginas</span>
        </a>
        <a href="/admin/categorias" class="nav-item <%= path.startsWith('/categorias') ? 'ativo' : '' %>" data-tooltip="Categorias">
          <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span>
          <span class="nav-texto">Categorias</span>
        </a>
      <% } %>

      <% if (usuarioLogado.papel === 'administrador') { %>
        <p class="sidebar-secao">Sistema</p>
        <a href="/admin/usuarios" class="nav-item <%= path.startsWith('/usuarios') ? 'ativo' : '' %>" data-tooltip="Usuários">
          <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          <span class="nav-texto">Usuários</span>
        </a>
        <a href="/admin/configuracoes" class="nav-item <%= path.startsWith('/configuracoes') ? 'ativo' : '' %>" data-tooltip="Configurações">
          <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
          <span class="nav-texto">Configurações</span>
        </a>
      <% } %>

      <p class="sidebar-secao">Atalhos</p>
      <a href="/" target="_blank" class="nav-item" data-tooltip="Ver site">
        <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></span>
        <span class="nav-texto">Ver site</span>
      </a>
      <a href="/logout" class="nav-item nav-sair" data-tooltip="Sair">
        <span class="nav-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
        <span class="nav-texto">Sair</span>
      </a>
    </nav>

    <div class="sidebar-rodape">
      <div class="sidebar-user">
        <span class="sidebar-user-avatar" aria-hidden="true"><%= usuarioLogado.nome.charAt(0).toUpperCase() %></span>
        <div class="sidebar-user-info">
          <strong class="nav-texto"><%= usuarioLogado.nome %></strong>
          <span class="nav-texto sidebar-user-papel"><%= usuarioLogado.papel %></span>
        </div>
      </div>
      <button type="button" class="sidebar-collapse" id="sidebar-collapse" aria-label="Recolher menu">
        <svg class="icone-collapse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        <span class="nav-texto">Recolher menu</span>
      </button>
    </div>
  </aside>

  <div class="conteudo">
    <header class="topbar">
      <button class="topbar-menu-btn" id="topbar-menu-btn" aria-label="Abrir menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="topbar-esquerda">
        <span class="topbar-titulo"><%= titulo %></span>
      </div>
      <div class="topbar-direita">
        <div class="topbar-user-menu" id="topbar-user-menu">
          <button type="button" class="topbar-user-btn" id="topbar-user-btn" aria-haspopup="true" aria-expanded="false" aria-controls="topbar-user-dropdown">
            <span class="avatar" aria-hidden="true"><%= usuarioLogado.nome.charAt(0).toUpperCase() %></span>
            <span class="topbar-user-btn-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
            </span>
          </button>
          <div class="topbar-user-dropdown" id="topbar-user-dropdown" hidden>
            <div class="topbar-user-dropdown-header">
              <span class="avatar avatar--lg" aria-hidden="true"><%= usuarioLogado.nome.charAt(0).toUpperCase() %></span>
              <div class="topbar-user-dropdown-info">
                <strong><%= usuarioLogado.nome %></strong>
                <span class="papel"><%= usuarioLogado.papel %></span>
              </div>
            </div>
            <div class="topbar-user-dropdown-divider" role="separator"></div>
            <nav class="topbar-user-dropdown-nav" aria-label="Menu do usuário">
              <a href="/" target="_blank" rel="noopener noreferrer" class="topbar-user-dropdown-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Ver site
              </a>
              <a href="/logout" class="topbar-user-dropdown-item topbar-user-dropdown-item--sair">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sair
              </a>
            </nav>
          </div>
        </div>
      </div>
    </header>
    <main>
      <% mensagens.sucesso.forEach(function (m) { %><div class="alert alert-sucesso"><%= m %></div><% }) %>
      <% mensagens.erro.forEach(function (m) { %><div class="alert alert-erro"><%= m %></div><% }) %>
      <%- body %>
    </main>
  </div>

  <script>
    (function () {
      var body = document.getElementById('admin-body');
      var sidebar = document.getElementById('sidebar');
      var nav = document.getElementById('sidebar-nav');
      var btnMobile = document.getElementById('sidebar-toggle');
      var btnTopbar = document.getElementById('topbar-menu-btn');
      var btnCollapse = document.getElementById('sidebar-collapse');

      if (localStorage.getItem('sidebar-recolhida') === '1') {
        body.classList.add('sidebar-recolhida');
      }

      function toggleMobile() {
        var aberto = sidebar.classList.toggle('mobile-aberto');
        body.classList.toggle('sidebar-overlay', aberto);
        if (btnMobile) btnMobile.setAttribute('aria-expanded', String(aberto));
      }

      if (btnMobile) btnMobile.addEventListener('click', toggleMobile);
      if (btnTopbar) btnTopbar.addEventListener('click', toggleMobile);

      if (btnCollapse) {
        btnCollapse.addEventListener('click', function () {
          body.classList.toggle('sidebar-recolhida');
          localStorage.setItem('sidebar-recolhida', body.classList.contains('sidebar-recolhida') ? '1' : '0');
        });
      }

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 720 && sidebar.classList.contains('mobile-aberto')) {
          if (!sidebar.contains(e.target) && e.target !== btnTopbar && !btnTopbar.contains(e.target)) {
            sidebar.classList.remove('mobile-aberto');
            body.classList.remove('sidebar-overlay');
            if (btnMobile) btnMobile.setAttribute('aria-expanded', 'false');
          }
        }
      });

      var userMenu = document.getElementById('topbar-user-menu');
      var userBtn = document.getElementById('topbar-user-btn');
      var userDropdown = document.getElementById('topbar-user-dropdown');

      function fecharUserMenu() {
        if (!userMenu || !userBtn || !userDropdown) return;
        userMenu.classList.remove('aberto');
        userBtn.setAttribute('aria-expanded', 'false');
        userDropdown.hidden = true;
      }

      function abrirUserMenu() {
        if (!userMenu || !userBtn || !userDropdown) return;
        userMenu.classList.add('aberto');
        userBtn.setAttribute('aria-expanded', 'true');
        userDropdown.hidden = false;
      }

      if (userBtn && userDropdown) {
        userBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (userMenu.classList.contains('aberto')) fecharUserMenu();
          else abrirUserMenu();
        });

        document.addEventListener('click', function (e) {
          if (!userMenu.contains(e.target)) fecharUserMenu();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') fecharUserMenu();
        });
      }
    })();
  </script>
</body>
</html>
