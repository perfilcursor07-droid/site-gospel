<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    const nomeSite = config.site_nome || 'Site Gospel';
    const tituloSeo = titulo === 'Início' ? (config.seo_titulo || nomeSite) : `${titulo} | ${nomeSite}`;
    const desc = (typeof metaDescricao !== 'undefined' && metaDescricao) ? metaDescricao : (config.seo_descricao || '');
    const ehArtigo = typeof artigo !== 'undefined' && artigo;
    const ogImagem = ehArtigo && artigo.imagem
      ? urlBase + artigo.imagem
      : (config.og_imagem ? urlBase + config.og_imagem : (config.logo ? urlBase + config.logo : null));
  %>
  <title><%= tituloSeo %></title>
  <% if (desc) { %><meta name="description" content="<%= desc %>"><% } %>
  <% if (config.seo_palavras_chave) { %><meta name="keywords" content="<%= config.seo_palavras_chave %>"><% } %>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= urlAtual %>">
  <% if (config.google_site_verification) { %><meta name="google-site-verification" content="<%= config.google_site_verification %>"><% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="<%= ehArtigo ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= nomeSite %>">
  <meta property="og:title" content="<%= tituloSeo %>">
  <% if (desc) { %><meta property="og:description" content="<%= desc %>"><% } %>
  <meta property="og:url" content="<%= urlAtual %>">
  <meta property="og:locale" content="pt_BR">
  <% if (ogImagem) { %><meta property="og:image" content="<%= ogImagem %>"><% } %>
  <% if (ehArtigo && artigo.publicadoEm) { %><meta property="article:published_time" content="<%= new Date(artigo.publicadoEm).toISOString() %>"><% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="<%= ogImagem ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= tituloSeo %>">
  <% if (desc) { %><meta name="twitter:description" content="<%= desc %>"><% } %>
  <% if (ogImagem) { %><meta name="twitter:image" content="<%= ogImagem %>"><% } %>

  <!-- Dados estruturados (JSON-LD) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= nomeSite %>",
    "url": "<%= urlBase %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= urlBase %>/busca?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <% if (ehArtigo) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": "<%= artigo.titulo %>",
    "description": "<%= artigo.resumo || desc %>",
    <% if (artigo.imagem) { %>"image": ["<%= urlBase %><%= artigo.imagem %>"],<% } %>
    <% if (artigo.publicadoEm) { %>"datePublished": "<%= new Date(artigo.publicadoEm).toISOString() %>",<% } %>
    "dateModified": "<%= new Date(artigo.updatedAt).toISOString() %>",
    "author": { "@type": "Person", "name": "<%= artigo.autor ? artigo.autor.nome : nomeSite %>" },
    "publisher": { "@type": "Organization", "name": "<%= nomeSite %>"<% if (config.logo) { %>, "logo": { "@type": "ImageObject", "url": "<%= urlBase %><%= config.logo %>" }<% } %> },
    "mainEntityOfPage": "<%= urlAtual %>"
  }
  </script>
  <% } %>

  <% if (config.google_analytics) { %>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= config.google_analytics %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= config.google_analytics %>');
  </script>
  <% } %>

  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
      <a href="/" class="text-2xl sm:text-3xl tracking-tight text-orange-600 font-light">
        <% if (config.logo) { %>
          <img src="<%= config.logo %>" alt="<%= nomeSite %>" class="h-9 sm:h-11 w-auto">
        <% } else { %>
          site<span class="font-extrabold">gospel</span>
        <% } %>
      </a>
      <form action="/busca" method="get" class="flex w-full sm:w-auto">
        <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Buscar no site..."
          class="w-full sm:w-64 px-4 py-2 text-sm bg-gray-100 rounded-l-full focus:outline-none focus:ring-2 focus:ring-orange-500">
        <button class="px-5 bg-orange-600 text-white rounded-r-full text-sm font-bold hover:bg-orange-700 transition">Buscar</button>
      </form>
    </div>
    <nav class="border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4 flex gap-1 overflow-x-auto">
        <a href="/" class="px-3 py-3 text-sm font-bold text-gray-600 whitespace-nowrap border-b-2 border-transparent hover:text-orange-600 hover:border-orange-600 transition">início</a>
        <% categoriasNav.forEach(function (c) { %>
          <a href="/categoria/<%= c.slug %>" class="px-3 py-3 text-sm font-bold text-gray-600 whitespace-nowrap border-b-2 border-transparent hover:text-orange-600 hover:border-orange-600 transition"><%= c.nome.toLowerCase() %></a>
        <% }) %>
        <a href="/pagina/sobre" class="px-3 py-3 text-sm font-bold text-gray-600 whitespace-nowrap border-b-2 border-transparent hover:text-orange-600 hover:border-orange-600 transition">sobre</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
    <% mensagens.sucesso.forEach(function (m) { %><div class="mb-4 px-4 py-3 rounded-lg bg-green-100 text-green-800 text-sm"><%= m %></div><% }) %>
    <% mensagens.erro.forEach(function (m) { %><div class="mb-4 px-4 py-3 rounded-lg bg-red-100 text-red-800 text-sm"><%= m %></div><% }) %>
    <%- body %>
  </main>

  <footer class="bg-gray-900 text-gray-400 mt-12">
    <div class="max-w-6xl mx-auto px-4 py-6 flex flex-col sm:flex-row justify-between gap-2 text-sm">
      <p>© <%= new Date().getFullYear() %> <%= nomeSite %>. Todos os direitos reservados.</p>
      <a href="/login" class="hover:text-white transition">área administrativa</a>
    </div>
  </footer>
</body>
</html>
