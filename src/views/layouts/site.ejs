<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> | Site Gospel</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <header class="topo">
    <div class="container topo-inner">
      <a href="/" class="logo">✝ site<strong>gospel</strong></a>
      <form class="busca" action="/busca" method="get">
        <input type="text" name="q" placeholder="Buscar no site..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button type="submit" aria-label="Buscar">🔍</button>
      </form>
    </div>
    <nav class="menu">
      <div class="container menu-inner">
        <a href="/">início</a>
        <% categoriasNav.forEach(function (c) { %>
          <a href="/categoria/<%= c.slug %>"><%= c.nome.toLowerCase() %></a>
        <% }) %>
        <a href="/pagina/sobre">sobre</a>
      </div>
    </nav>
  </header>
  <main class="container principal">
    <% mensagens.sucesso.forEach(function (m) { %><div class="alert alert-sucesso"><%= m %></div><% }) %>
    <% mensagens.erro.forEach(function (m) { %><div class="alert alert-erro"><%= m %></div><% }) %>
    <%- body %>
  </main>
  <footer class="rodape">
    <div class="container rodape-inner">
      <p>© <%= new Date().getFullYear() %> Site Gospel. Todos os direitos reservados.</p>
      <a href="/login">área administrativa</a>
    </div>
  </footer>
</body>
</html>
