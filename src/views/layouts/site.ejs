<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    const nomeSite = config.site_nome || 'Site Gospel';
    const corPrimaria = config.cor_primaria || '#ea580c';
    const ehArtigo = typeof artigo !== 'undefined' && artigo;
    let tituloSeo = titulo === 'Início' ? (config.seo_titulo || nomeSite) : `${titulo} | ${nomeSite}`;
    if (ehArtigo && artigo.metaTitle) tituloSeo = artigo.metaTitle;
    const desc = (typeof metaDescricao !== 'undefined' && metaDescricao) ? metaDescricao : (config.seo_descricao || '');
    const ogImagem = ehArtigo && artigo.imagem
      ? urlBase + artigo.imagem
      : (config.og_imagem ? urlBase + config.og_imagem : (config.logo ? urlBase + config.logo : null));
    const indexar = (config.seo_indexar || 'sim') !== 'nao';
    const linksFooter = (config.footer_links || '').split('\n').map(function (l) {
      const partes = l.split('|');
      return { texto: (partes[0] || '').trim(), url: (partes[1] || '').trim() };
    }).filter(function (l) { return l.texto && l.url; });
    const redes = [
      { chave: 'social_facebook', nome: 'Facebook' },
      { chave: 'social_instagram', nome: 'Instagram' },
      { chave: 'social_youtube', nome: 'YouTube' },
      { chave: 'social_whatsapp', nome: 'WhatsApp' }
    ].filter(function (r) { return config[r.chave]; });
  %>
  <title><%= tituloSeo %></title>
  <% if (desc) { %><meta name="description" content="<%= desc %>"><% } %>
  <% if (config.seo_palavras_chave) { %><meta name="keywords" content="<%= config.seo_palavras_chave %>"><% } %>
  <meta name="robots" content="<%= indexar ? 'index, follow' : 'noindex, nofollow' %>">
  <link rel="canonical" href="<%= urlAtual %>">
  <% if (config.favicon) { %><link rel="icon" href="<%= config.favicon %>"><% } %>
  <% if (config.google_site_verification) { %><meta name="google-site-verification" content="<%= config.google_site_verification %>"><% } %>

  <meta property="og:type" content="<%= ehArtigo ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= nomeSite %>">
  <meta property="og:title" content="<%= tituloSeo %>">
  <% if (desc) { %><meta property="og:description" content="<%= desc %>"><% } %>
  <meta property="og:url" content="<%= urlAtual %>">
  <meta property="og:locale" content="pt_BR">
  <% if (ogImagem) { %><meta property="og:image" content="<%= ogImagem %>"><% } %>
  <% if (ehArtigo && artigo.publicadoEm) { %><meta property="article:published_time" content="<%= new Date(artigo.publicadoEm).toISOString() %>"><% } %>

  <meta name="twitter:card" content="<%= ogImagem ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= tituloSeo %>">
  <% if (desc) { %><meta name="twitter:description" content="<%= desc %>"><% } %>
  <% if (ogImagem) { %><meta name="twitter:image" content="<%= ogImagem %>"><% } %>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= nomeSite %>",
    "url": "<%= urlBase %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= urlBase %>/busca?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <% if (ehArtigo) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": "<%= artigo.titulo %>",
    "description": "<%= artigo.resumo || desc %>",
    <% if (artigo.imagem) { %>"image": ["<%= urlBase %><%= artigo.imagem %>"],<% } %>
    <% if (artigo.publicadoEm) { %>"datePublished": "<%= new Date(artigo.publicadoEm).toISOString() %>",<% } %>
    "dateModified": "<%= new Date(artigo.updatedAt).toISOString() %>",
    "author": { "@type": "Person", "name": "<%= artigo.autor ? artigo.autor.nome : nomeSite %>" },
    "publisher": { "@type": "Organization", "name": "<%= nomeSite %>"<% if (config.logo) { %>, "logo": { "@type": "ImageObject", "url": "<%= urlBase %><%= config.logo %>" }<% } %> },
    "mainEntityOfPage": "<%= urlAtual %>"
  }
  </script>
  <% } %>

  <% if (config.google_analytics) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= config.google_analytics %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= config.google_analytics %>');
  </script>
  <% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: '<%= corPrimaria %>' },
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] }
        }
      }
    };
  </script>
  <%- config.head_custom || '' %>
</head>
<body class="bg-[#f5f5f5] text-gray-800 font-sans antialiased">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-3 sm:py-4 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <button id="btn-menu" class="lg:hidden p-2 -ml-2 text-gray-700" aria-label="Abrir menu" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href="/" class="text-2xl sm:text-3xl tracking-tight font-light" style="color: <%= corPrimaria %>">
          <% if (config.logo) { %>
            <img src="<%= config.logo %>" alt="<%= nomeSite %>" class="h-9 sm:h-11 w-auto">
          <% } else { %>
            site<span class="font-extrabold">gospel</span>
          <% } %>
        </a>
      </div>
      <form action="/busca" method="get" class="hidden md:flex">
        <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Buscar no site..."
          class="w-56 lg:w-72 px-4 py-2 text-sm bg-gray-100 rounded-l-full focus:outline-none focus:ring-2 focus:ring-primary">
        <button class="px-5 bg-primary text-white rounded-r-full text-sm font-bold hover:opacity-90 transition">Buscar</button>
      </form>
    </div>
    <nav id="menu-categorias" class="hidden lg:block border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4 flex flex-col lg:flex-row lg:items-center gap-0 lg:gap-1 lg:overflow-x-auto">
        <form action="/busca" method="get" class="flex md:hidden py-3">
          <input type="text" name="q" placeholder="Buscar no site..."
            class="w-full px-4 py-2 text-sm bg-gray-100 rounded-l-full focus:outline-none focus:ring-2 focus:ring-primary">
          <button class="px-5 bg-primary text-white rounded-r-full text-sm font-bold">Buscar</button>
        </form>
        <a href="/" class="px-3 py-3 text-sm font-bold text-gray-600 whitespace-nowrap border-b-2 border-transparent hover:text-primary hover:border-primary transition">início</a>
        <% categoriasNav.forEach(function (c) { %>
          <a href="/categoria/<%= c.slug %>" style="--cat: <%= c.corHex || corPrimaria %>"
            class="px-3 py-3 text-sm font-bold text-gray-600 whitespace-nowrap border-b-2 border-transparent hover:text-[color:var(--cat)] hover:border-[color:var(--cat)] transition"><%= c.nome.toLowerCase() %></a>
        <% }) %>
        <a href="/pagina/sobre" class="px-3 py-3 text-sm font-bold text-gray-600 whitespace-nowrap border-b-2 border-transparent hover:text-primary hover:border-primary transition">sobre</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <% mensagens.sucesso.forEach(function (m) { %><div class="mb-4 px-4 py-3 rounded-lg bg-green-100 text-green-800 text-sm"><%= m %></div><% }) %>
    <% mensagens.erro.forEach(function (m) { %><div class="mb-4 px-4 py-3 rounded-lg bg-red-100 text-red-800 text-sm"><%= m %></div><% }) %>
    <%- body %>
  </main>

  <footer class="bg-gray-900 text-gray-400 mt-16">
    <div class="max-w-6xl mx-auto px-4 py-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
      <div>
        <p class="text-2xl font-light tracking-tight" style="color: <%= corPrimaria %>">
          <% if (config.logo) { %><img src="<%= config.logo %>" alt="<%= nomeSite %>" class="h-9 w-auto"><% } else { %>site<span class="font-extrabold">gospel</span><% } %>
        </p>
        <% if (config.site_slogan) { %><p class="mt-2 text-sm font-bold text-gray-300"><%= config.site_slogan %></p><% } %>
        <% if (config.site_descricao) { %><p class="mt-2 text-sm leading-relaxed"><%= config.site_descricao %></p><% } %>
        <% if (redes.length) { %>
        <div class="mt-4 flex gap-3">
          <% redes.forEach(function (r) { %>
            <a href="<%= config[r.chave] %>" target="_blank" rel="noopener" title="<%= r.nome %>"
              class="w-9 h-9 flex items-center justify-center rounded-full bg-gray-800 text-gray-300 text-xs font-extrabold uppercase hover:text-white transition" style="border: 1px solid <%= corPrimaria %>">
              <%= r.nome.slice(0, 2) %>
            </a>
          <% }) %>
        </div>
        <% } %>
      </div>
      <div>
        <h3 class="text-sm font-extrabold uppercase tracking-widest text-white mb-4">Categorias</h3>
        <ul class="space-y-2 text-sm">
          <% categoriasNav.forEach(function (c) { %>
            <li><a href="/categoria/<%= c.slug %>" class="hover:text-white transition"><%= c.nome %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-extrabold uppercase tracking-widest text-white mb-4">Links úteis</h3>
        <ul class="space-y-2 text-sm">
          <% if (linksFooter.length) { %>
            <% linksFooter.forEach(function (l) { %>
              <li><a href="<%= l.url %>" class="hover:text-white transition"><%= l.texto %></a></li>
            <% }) %>
          <% } else { %>
            <li><a href="/pagina/sobre" class="hover:text-white transition">Sobre</a></li>
            <li><a href="/busca" class="hover:text-white transition">Busca</a></li>
          <% } %>
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-800">
      <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row justify-between gap-2 text-sm">
        <p><%= config.footer_copyright || `© ${new Date().getFullYear()} ${nomeSite}. Todos os direitos reservados.` %></p>
        <a href="/login" class="hover:text-white transition">área administrativa</a>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var btn = document.getElementById('btn-menu');
      var menu = document.getElementById('menu-categorias');
      if (btn && menu) {
        btn.addEventListener('click', function () {
          var aberto = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!aberto));
        });
      }
    })();
  </script>
</body>
</html>
