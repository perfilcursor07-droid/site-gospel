<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    const nomeSite = config.site_nome || 'Site Gospel';
    const corPrimaria = config.cor_primaria || '#ea580c';
    const ehArtigo = typeof artigo !== 'undefined' && artigo;
    let tituloSeo = titulo === 'Início' ? (config.seo_titulo || nomeSite) : `${titulo} | ${nomeSite}`;
    if (ehArtigo && artigo.metaTitle) tituloSeo = artigo.metaTitle;
    const desc = (typeof metaDescricao !== 'undefined' && metaDescricao) ? metaDescricao : (config.seo_descricao || '');
    const ogImagem = ehArtigo && artigo.imagem
      ? urlBase + artigo.imagem
      : (config.og_imagem ? urlBase + config.og_imagem : (config.logo ? urlBase + config.logo : null));
    const indexar = (config.seo_indexar || 'sim') !== 'nao';
    const linksFooter = (config.footer_links || '').split('\n').map(function (l) {
      const partes = l.split('|');
      return { texto: (partes[0] || '').trim(), url: (partes[1] || '').trim() };
    }).filter(function (l) { return l.texto && l.url; });
    const urlsPaginas = new Set((paginasNav || []).map(function (p) { return '/pagina/' + p.slug; }));
    const linksFooterExtras = linksFooter.filter(function (l) { return !urlsPaginas.has(l.url); });
    const redes = [
      { chave: 'social_facebook', nome: 'Facebook' },
      { chave: 'social_instagram', nome: 'Instagram' },
      { chave: 'social_youtube', nome: 'YouTube' },
      { chave: 'social_whatsapp', nome: 'WhatsApp' }
    ].filter(function (r) { return config[r.chave]; });
  %>
  <title><%= tituloSeo %></title>
  <% if (desc) { %><meta name="description" content="<%= desc %>"><% } %>
  <% if (config.seo_palavras_chave) { %><meta name="keywords" content="<%= config.seo_palavras_chave %>"><% } %>
  <meta name="robots" content="<%= indexar ? 'index, follow' : 'noindex, nofollow' %>">
  <link rel="canonical" href="<%= urlAtual %>">
  <link rel="alternate" type="application/rss+xml" title="<%= nomeSite %> — RSS" href="<%= urlBase %>/feed.xml">
  <% if (ehArtigo && (config.amp_habilitado || 'nao') === 'sim') { %>
  <link rel="amphtml" href="<%= urlBase %>/post/<%= artigo.slug %>/amp">
  <% } %>
  <% if (config.favicon) { %><link rel="icon" href="<%= config.favicon %>"><% } %>
  <% if (config.google_site_verification) { %><meta name="google-site-verification" content="<%= config.google_site_verification %>"><% } %>

  <meta property="og:type" content="<%= ehArtigo ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= nomeSite %>">
  <meta property="og:title" content="<%= tituloSeo %>">
  <% if (desc) { %><meta property="og:description" content="<%= desc %>"><% } %>
  <meta property="og:url" content="<%= urlAtual %>">
  <meta property="og:locale" content="pt_BR">
  <% if (ogImagem) { %><meta property="og:image" content="<%= ogImagem %>"><% } %>
  <% if (ehArtigo && artigo.imagemAlt) { %><meta property="og:image:alt" content="<%= artigo.imagemAlt %>"><% } %>
  <% if (ehArtigo && artigo.publicadoEm) { %><meta property="article:published_time" content="<%= new Date(artigo.publicadoEm).toISOString() %>"><% } %>

  <meta name="twitter:card" content="<%= ogImagem ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= tituloSeo %>">
  <% if (desc) { %><meta name="twitter:description" content="<%= desc %>"><% } %>
  <% if (ogImagem) { %><meta name="twitter:image" content="<%= ogImagem %>"><% } %>
  <% if (ehArtigo && artigo.imagemAlt) { %><meta name="twitter:image:alt" content="<%= artigo.imagemAlt %>"><% } %>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= nomeSite %>",
    "url": "<%= urlBase %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= urlBase %>/busca?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <% if (ehArtigo) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": "<%= artigo.titulo %>",
    "description": "<%= artigo.resumo || desc %>",
    <% if (artigo.imagem) { %>"image": ["<%= urlBase %><%= artigo.imagem %>"],<% } %>
    <% if (artigo.publicadoEm) { %>"datePublished": "<%= new Date(artigo.publicadoEm).toISOString() %>",<% } %>
    "dateModified": "<%= new Date(artigo.updatedAt).toISOString() %>",
    "author": { "@type": "Person", "name": "<%= artigo.autor ? artigo.autor.nome : nomeSite %>" },
    "publisher": { "@type": "Organization", "name": "<%= nomeSite %>"<% if (config.logo) { %>, "logo": { "@type": "ImageObject", "url": "<%= urlBase %><%= config.logo %>" }<% } %> },
    "mainEntityOfPage": "<%= urlAtual %>"
  }
  </script>
  <% } %>

  <% if (config.google_analytics) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= config.google_analytics %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= config.google_analytics %>');
  </script>
  <% } %>

  <% if (config.google_adsense) { %>
  <%- config.google_adsense %>
  <% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: '<%= corPrimaria %>' },
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] }
        }
      }
    };
  </script>
  <%- config.head_custom || '' %>
</head>
<body class="bg-white text-gray-800 font-sans antialiased<%= usuarioLogado ? ' has-admin-bar' : '' %>">
  <% if (usuarioLogado) {
    const postAberto = (typeof post !== 'undefined' && post) ? post : ((typeof artigo !== 'undefined' && artigo) ? artigo : null);
    const podeEditarPost = postAberto && (
      ['administrador', 'gestor'].includes(usuarioLogado.papel) ||
      Number(postAberto.autorId) === Number(usuarioLogado.id)
    );
  %>
  <div class="site-admin-bar" id="site-admin-bar" role="navigation" aria-label="Barra administrativa">
    <div class="site-admin-bar-inner max-w-6xl mx-auto px-3 sm:px-4">
      <div class="site-admin-bar-links">
        <a href="/admin" class="site-admin-bar-brand" title="Painel administrativo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span>Painel</span>
        </a>
        <% if (podeEditarPost) { %>
          <a href="/admin/posts/<%= postAberto.id %>/editar" class="site-admin-bar-link site-admin-bar-link--destaque">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
            <span>Editar post</span>
          </a>
        <% } %>
        <a href="/admin/posts" class="site-admin-bar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Posts</span>
        </a>
        <% if (usuarioLogado.papel !== 'usuario') { %>
          <a href="/admin/posts/novo" class="site-admin-bar-link site-admin-bar-link--hide-mobile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Novo post</span>
          </a>
        <% } %>
      </div>
      <div class="site-admin-bar-user">
        <span class="site-admin-bar-nome"><%= usuarioLogado.nome %></span>
        <a href="/logout" class="site-admin-bar-link site-admin-bar-link--sair">Sair</a>
      </div>
    </div>
  </div>
  <% } %>
  <header id="site-header" class="site-header sticky z-50" style="--cor-primaria: <%= corPrimaria %>">
    <div class="site-header-bar">
      <div class="site-header-inner">
        <div class="site-header-top">
          <button type="button" id="btn-menu" class="site-header-menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-lateral">
            <span class="site-header-menu-icon" aria-hidden="true">
              <span></span><span></span><span></span>
              <span></span><span></span><span></span>
              <span></span><span></span><span></span>
            </span>
            <span class="site-header-menu-label">Menu</span>
          </button>

          <a href="/" class="site-header-logo" style="color: <%= corPrimaria %>">
            <% if (config.logo) { %>
              <img src="<%= config.logo %>" alt="<%= nomeSite %>">
            <% } else { %>
              <span class="site-header-logo-text">site<span>gospel</span></span>
            <% } %>
          </a>

          <div class="site-header-actions" id="header-actions">
            <a href="<%= usuarioLogado ? '/admin' : '/login' %>" class="site-header-conta" title="<%= usuarioLogado ? 'Painel administrativo' : 'Entrar' %>">
              <span class="site-header-conta-label"><%= usuarioLogado ? 'Conta' : 'Entrar' %></span>
              <svg class="site-header-conta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="8" r="3.2"/>
                <path stroke-linecap="round" d="M5.5 19.2c.8-3.2 3.2-5 6.5-5s5.7 1.8 6.5 5"/>
              </svg>
            </a>
            <span class="site-header-sep" aria-hidden="true"></span>
            <div class="site-header-search-wrap" id="wrap-busca">
              <button type="button" id="btn-busca-toggle" class="site-header-busca-btn" aria-label="Abrir busca" aria-expanded="false" aria-controls="form-busca-header">
                <span class="site-header-busca-label">Busca</span>
                <svg class="site-header-busca-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5"/>
                  <path stroke-linecap="round" d="M16.5 16.5L21 21"/>
                </svg>
              </button>
              <form action="/busca" method="get" id="form-busca-header" class="site-header-search">
                <label class="site-header-search-field">
                  <svg class="site-header-search-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5"/>
                    <path stroke-linecap="round" d="M16.5 16.5L21 21"/>
                  </svg>
                  <input type="search" name="q" id="input-busca-header" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Buscar no site..." class="site-header-search-input" autocomplete="off">
                </label>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="site-drawer-overlay" id="menu-overlay" hidden></div>
  <aside class="site-drawer" id="menu-lateral" aria-hidden="true" aria-label="Menu do site">
    <div class="site-drawer-inner">
      <div class="site-drawer-topo">
        <button type="button" class="site-drawer-fechar" id="btn-fechar-menu" aria-label="Fechar menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
      </div>

      <a href="<%= usuarioLogado ? '/admin' : '/login' %>" class="site-drawer-conta">
        <span class="site-drawer-conta-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="8" r="3.2"/>
            <path stroke-linecap="round" d="M5.5 19.2c.8-3.2 3.2-5 6.5-5s5.7 1.8 6.5 5"/>
          </svg>
        </span>
        <span class="site-drawer-conta-texto">
          <% if (usuarioLogado) { %>
            <strong><%= usuarioLogado.nome %></strong>
            <small>Acessar painel</small>
          <% } else { %>
            <strong>Acesse sua conta</strong>
            <small>ou cadastre-se grátis</small>
          <% } %>
        </span>
      </a>

      <% if (categoriasNav && categoriasNav.length) { %>
      <nav class="site-drawer-secao" aria-label="Categorias">
        <% categoriasNav.forEach(function (c) { %>
          <a href="/categoria/<%= c.slug %>" class="site-drawer-item">
            <span class="site-drawer-item-marca" style="background: <%= c.corHex || corPrimaria %>" aria-hidden="true"><%= (c.nome || '?').charAt(0).toUpperCase() %></span>
            <span class="site-drawer-item-nome"><%= c.nome %></span>
          </a>
        <% }) %>
      </nav>
      <% } %>

      <nav class="site-drawer-secao site-drawer-secao--links" aria-label="Páginas">
        <a href="/" class="site-drawer-link">Início</a>
        <% (paginasNav || []).forEach(function (p) { %>
          <a href="/pagina/<%= p.slug %>" class="site-drawer-link"><%= p.titulo %></a>
        <% }) %>
        <% linksFooterExtras.forEach(function (l) { %>
          <a href="<%= l.url %>" class="site-drawer-link"><%= l.texto %></a>
        <% }) %>
        <a href="/busca" class="site-drawer-link">Busca</a>
      </nav>
    </div>
  </aside>

  <main class="max-w-6xl mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <% mensagens.sucesso.forEach(function (m) { %><div class="mb-4 px-4 py-3 rounded-lg bg-green-100 text-green-800 text-sm"><%= m %></div><% }) %>
    <% mensagens.erro.forEach(function (m) { %><div class="mb-4 px-4 py-3 rounded-lg bg-red-100 text-red-800 text-sm"><%= m %></div><% }) %>
    <%- body %>
  </main>

  <footer class="site-footer mt-16" style="--cor-primaria: <%= corPrimaria %>">
    <div class="site-footer-inner max-w-6xl mx-auto px-4 py-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
      <div>
        <a href="/" class="site-footer-logo inline-block">
          <% if (config.logo) { %>
            <img src="<%= config.logo %>" alt="<%= nomeSite %>">
          <% } else { %>
            <span class="site-footer-logo-text" style="color: <%= corPrimaria %>">site<span class="font-extrabold">gospel</span></span>
          <% } %>
        </a>
        <% if (config.site_slogan) { %><p class="site-footer-slogan"><%= config.site_slogan %></p><% } %>
        <% if (config.site_descricao) { %><p class="site-footer-desc"><%= config.site_descricao %></p><% } %>
        <% if (redes.length) { %>
        <div class="site-footer-redes">
          <% redes.forEach(function (r) { %>
            <a href="<%= config[r.chave] %>" target="_blank" rel="noopener" title="<%= r.nome %>" class="site-footer-rede">
              <%= r.nome.slice(0, 2) %>
            </a>
          <% }) %>
        </div>
        <% } %>
      </div>
      <div>
        <h3 class="site-footer-titulo">Categorias</h3>
        <ul class="site-footer-links">
          <% categoriasNav.forEach(function (c) { %>
            <li><a href="/categoria/<%= c.slug %>"><%= c.nome %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h3 class="site-footer-titulo">Links úteis</h3>
        <ul class="site-footer-links">
          <% paginasNav.forEach(function (p) { %>
            <li><a href="/pagina/<%= p.slug %>"><%= p.titulo %></a></li>
          <% }) %>
          <% linksFooterExtras.forEach(function (l) { %>
            <li><a href="<%= l.url %>"><%= l.texto %></a></li>
          <% }) %>
          <% if (!paginasNav.length && !linksFooterExtras.length) { %>
            <li><a href="/busca">Busca</a></li>
          <% } %>
        </ul>
      </div>
    </div>
    <div class="site-footer-rodape">
      <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row justify-between gap-2 text-sm">
        <p><%= config.footer_copyright || `© ${new Date().getFullYear()} ${nomeSite}. Todos os direitos reservados.` %></p>
        <a href="/login" class="site-footer-admin">área administrativa</a>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var btn = document.getElementById('btn-menu');
      var drawer = document.getElementById('menu-lateral');
      var overlay = document.getElementById('menu-overlay');
      var btnFechar = document.getElementById('btn-fechar-menu');
      var header = document.getElementById('site-header');

      function abrirMenu() {
        if (!drawer || !overlay) return;
        drawer.classList.add('is-open');
        overlay.hidden = false;
        overlay.classList.add('is-open');
        document.body.classList.add('menu-aberto');
        drawer.setAttribute('aria-hidden', 'false');
        if (btn) {
          btn.setAttribute('aria-expanded', 'true');
          btn.classList.add('is-active');
        }
      }

      function fecharMenu() {
        if (!drawer || !overlay) return;
        drawer.classList.remove('is-open');
        overlay.classList.remove('is-open');
        overlay.hidden = true;
        document.body.classList.remove('menu-aberto');
        drawer.setAttribute('aria-hidden', 'true');
        if (btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.classList.remove('is-active');
        }
      }

      if (btn) btn.addEventListener('click', function () {
        if (drawer && drawer.classList.contains('is-open')) fecharMenu();
        else abrirMenu();
      });
      if (btnFechar) btnFechar.addEventListener('click', fecharMenu);
      if (overlay) overlay.addEventListener('click', fecharMenu);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') fecharMenu();
      });

      var compacto = false;
      var LIGAR = 90;
      var DESLIGAR = 40;

      function atualizarHeader() {
        if (!header) return;
        var y = window.scrollY;
        var deveCompactar = compacto ? y > DESLIGAR : y > LIGAR;
        if (deveCompactar === compacto) return;
        compacto = deveCompactar;
        header.classList.toggle('header--compact', compacto);
      }

      window.addEventListener('scroll', atualizarHeader, { passive: true });
      atualizarHeader();

      var btnBusca = document.getElementById('btn-busca-toggle');
      var wrapBusca = document.getElementById('wrap-busca');
      var formBusca = document.getElementById('form-busca-header');
      var inputBusca = document.getElementById('input-busca-header');
      var buscaAberta = false;

      function definirBusca(aberta) {
        if (!wrapBusca || !formBusca || !btnBusca) return;
        buscaAberta = aberta;
        wrapBusca.classList.toggle('is-open', aberta);
        if (header) header.classList.toggle('search-open', aberta);
        btnBusca.setAttribute('aria-expanded', String(aberta));
        btnBusca.setAttribute('aria-label', aberta ? 'Fechar busca' : 'Abrir busca');
        if (aberta && inputBusca) {
          window.setTimeout(function () { inputBusca.focus(); }, 120);
        }
      }

      if (btnBusca && wrapBusca && formBusca) {
        btnBusca.addEventListener('click', function (e) {
          e.stopPropagation();
          definirBusca(!buscaAberta);
        });

        wrapBusca.addEventListener('click', function (e) {
          e.stopPropagation();
        });

        document.addEventListener('click', function () {
          if (buscaAberta) definirBusca(false);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && buscaAberta) definirBusca(false);
        });

        if (inputBusca && inputBusca.value.trim()) {
          definirBusca(true);
        }
      }
    })();
  </script>
</body>
</html>
