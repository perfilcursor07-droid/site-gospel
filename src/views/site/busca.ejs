<%
  function destacar(texto) {
    if (!texto) return '';
    const esc = String(texto).replace(/[&<>"']/g, function (s) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s];
    });
    if (!q) return esc;
    const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return esc.replace(re, '<mark class="bg-orange-100 text-orange-800 rounded px-0.5">$1</mark>');
  }
%>
<section>
  <h1 class="flex items-center gap-3 text-2xl font-extrabold text-gray-900 mb-2">
    <span class="w-1.5 h-7 bg-primary rounded-full"></span> Resultados para: "<%= q %>"
  </h1>
  <% if (q) { %><p class="text-sm text-gray-500 mb-6"><%= posts.length %> resultado<%= posts.length === 1 ? '' : 's' %> encontrado<%= posts.length === 1 ? '' : 's' %></p><% } %>

  <% if (posts.length) { %>
  <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100">
    <% posts.forEach(function (post) { %>
      <article class="group">
        <a href="/post/<%= post.slug %>" class="flex justify-between gap-5 p-5">
          <div class="flex-1 min-w-0">
            <% if (post.categoria) { %><span class="text-xs font-extrabold uppercase tracking-widest" style="color: <%= post.categoria.corHex || '#ea580c' %>"><%= post.categoria.nome %></span><% } %>
            <h3 class="mt-1 text-lg font-extrabold leading-snug text-gray-900 group-hover:underline"><%- destacar(post.titulo) %></h3>
            <% if (post.resumo) { %><p class="mt-1 text-sm text-gray-500 line-clamp-2"><%- destacar(post.resumo) %></p><% } %>
            <p class="mt-2 text-xs text-gray-400">
              <% if (post.autor) { %>Por <%= post.autor.nome %><% } %>
              <% if (post.publicadoEm) { %> • <%= new Date(post.publicadoEm).toLocaleDateString('pt-BR') %><% } %>
            </p>
          </div>
          <% if (post.imagem) { %><img src="<%= post.imagem %>" alt="<%= post.titulo %>" class="w-24 h-20 sm:w-32 sm:h-24 object-cover rounded flex-shrink-0"><% } %>
        </a>
      </article>
    <% }) %>
  </div>
  <% } else { %>
  <div class="bg-white rounded-lg border border-gray-200 p-10 text-center">
    <p class="text-4xl mb-3">🔍</p>
    <p class="text-lg font-bold text-gray-700"><%= q ? 'Nenhum resultado encontrado' : 'Digite algo para buscar' %></p>
    <p class="mt-1 text-sm text-gray-500"><%= q ? 'Tente outras palavras ou navegue pelas categorias no menu.' : 'Use o campo de busca no topo da página.' %></p>
    <a href="/" class="inline-block mt-6 px-6 py-2.5 bg-primary text-white font-bold rounded-full hover:opacity-90 transition">Voltar ao início</a>
  </div>
  <% } %>
</section>
