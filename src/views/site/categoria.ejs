<% const corCategoria = categoria.corHex || '#ea580c'; %>
<section>
  <header class="mb-6">
    <h1 class="flex items-center gap-3 text-2xl sm:text-3xl font-extrabold text-gray-900">
      <span class="w-1.5 h-8 rounded-full" style="background: <%= corCategoria %>"></span> <%= categoria.nome %>
    </h1>
    <% if (categoria.descricao) { %><p class="mt-2 text-gray-500 max-w-2xl"><%= categoria.descricao %></p><% } %>
  </header>

  <% if (posts.length) { %>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% posts.forEach(function (post) { %>
      <article class="bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-md transition group">
        <a href="/post/<%= post.slug %>" class="flex flex-col h-full">
          <% if (post.imagem) { %><img src="<%= post.imagem %>" alt="<%= post.imagemAlt || post.titulo %>" class="w-full aspect-video object-cover"><% } %>
          <div class="p-5 flex-1 flex flex-col">
            <span class="text-xs font-extrabold uppercase tracking-widest" style="color: <%= corCategoria %>"><%= categoria.nome %></span>
            <h3 class="mt-1 text-lg font-extrabold leading-snug text-gray-900 group-hover:underline"><%= post.titulo %></h3>
            <% if (post.resumo) { %><p class="mt-2 text-sm text-gray-500 line-clamp-3"><%= post.resumo %></p><% } %>
            <p class="mt-auto pt-3 text-xs text-gray-400">
              <% if (post.autor) { %>Por <%= post.autor.nome %><% } %>
              <% if (post.publicadoEm) { %> • <%= new Date(post.publicadoEm).toLocaleDateString('pt-BR') %><% } %>
            </p>
          </div>
        </a>
      </article>
    <% }) %>
  </div>

  <% if (totalPaginas > 1) { %>
  <nav class="mt-8 flex justify-center gap-2" aria-label="Paginação">
    <% for (let i = 1; i <= totalPaginas; i++) { %>
      <% if (i === paginaAtual) { %>
        <span class="w-10 h-10 flex items-center justify-center rounded-lg text-white text-sm font-bold" style="background: <%= corCategoria %>"><%= i %></span>
      <% } else { %>
        <a href="/categoria/<%= categoria.slug %>?pagina=<%= i %>" class="w-10 h-10 flex items-center justify-center rounded-lg bg-white border border-gray-200 text-gray-600 text-sm font-bold hover:border-gray-400 transition"><%= i %></a>
      <% } %>
    <% } %>
  </nav>
  <% } %>

  <% } else { %>
    <p class="bg-white rounded-lg border border-gray-200 p-6 text-gray-500">Nenhum post nesta categoria ainda.</p>
  <% } %>
</section>
