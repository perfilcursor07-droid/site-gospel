<section class="home-hero" style="--cor-primaria: <%= config.cor_primaria || '#ea580c' %>">
  <% if (principal) { %>
  <article class="home-destaque">
    <a href="/post/<%= principal.slug %>" class="home-destaque-link">
      <div class="home-destaque-media">
        <% if (principal.imagem) { %>
          <img src="<%= principal.imagem %>" alt="<%= principal.imagemAlt || principal.titulo %>" class="home-destaque-img">
        <% } else { %>
          <div class="home-destaque-img home-destaque-img--vazio" aria-hidden="true"></div>
        <% } %>
        <div class="home-destaque-overlay"></div>
      </div>
      <div class="home-destaque-conteudo">
        <% if (principal.categoria) { %>
          <span class="home-cat-badge" style="--cat-cor: <%= principal.categoria.corHex || '#ea580c' %>"><%= principal.categoria.nome %></span>
        <% } %>
        <h2 class="home-destaque-titulo"><%= principal.titulo %></h2>
        <% if (principal.resumo) { %>
          <p class="home-destaque-resumo"><%= principal.resumo %></p>
        <% } %>
        <% if (principal.publicadoEm) { %>
          <time class="home-destaque-data" datetime="<%= new Date(principal.publicadoEm).toISOString() %>">
            <%= new Date(principal.publicadoEm).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
          </time>
        <% } %>
      </div>
    </a>
  </article>

  <aside class="home-lateral" aria-label="Outras matérias em destaque">
    <div class="home-lateral-lista">
      <% laterais.forEach(function (post, i) { %>
        <article class="home-lateral-item">
          <a href="/post/<%= post.slug %>" class="home-lateral-link">
            <div class="home-lateral-corpo">
              <% if (post.categoria) { %>
                <span class="home-lateral-cat" style="color: <%= post.categoria.corHex || '#ea580c' %>"><%= post.categoria.nome %></span>
              <% } %>
              <h3 class="home-lateral-titulo"><%= post.titulo %></h3>
              <% if (post.resumo) { %>
                <p class="home-lateral-resumo"><%= post.resumo %></p>
              <% } %>
            </div>
            <% if (post.imagem) { %>
              <div class="home-lateral-thumb">
                <img src="<%= post.imagem %>" alt="<%= post.imagemAlt || post.titulo %>" loading="lazy">
              </div>
            <% } %>
          </a>
        </article>
      <% }) %>
      <% if (!laterais.length) { %>
        <p class="home-lateral-vazio">Nenhuma outra publicação.</p>
      <% } %>
    </div>
  </aside>
  <% } else { %>
  <div class="home-hero-vazio">
    <p>Nenhum post publicado ainda.</p>
  </div>
  <% } %>
</section>

<% if (typeof ultimasPublicacoes !== 'undefined' && (ultimasPublicacoes.length || homeHasMore)) { %>
<section class="home-publicacoes mt-10 sm:mt-14" style="--cor-primaria: <%= config.cor_primaria || '#ea580c' %>">
  <h2 class="home-publicacoes-titulo">
    <span class="home-publicacoes-barra"></span> Últimas publicações
  </h2>
  <div class="home-publicacoes-lista" id="home-publicacoes-lista">
    <%- include('partials/pub-items', { posts: ultimasPublicacoes }) %>
  </div>
  <div class="home-scroll-sentinel" id="home-scroll-sentinel" <%= homeHasMore ? '' : 'hidden' %> aria-hidden="true"></div>
  <p class="home-carregando" id="home-carregando" hidden>Carregando mais notícias…</p>
  <p class="home-fim-lista" id="home-fim-lista" <%= homeHasMore ? 'hidden' : '' %>>Você viu todas as publicações.</p>
</section>
<script>
(function () {
  var lista = document.getElementById('home-publicacoes-lista');
  var sentinel = document.getElementById('home-scroll-sentinel');
  var carregando = document.getElementById('home-carregando');
  var fimLista = document.getElementById('home-fim-lista');
  if (!lista || !sentinel) return;

  var offset = <%= typeof homeOffset !== 'undefined' ? homeOffset : 10 %>;
  var hasMore = <%= homeHasMore ? 'true' : 'false' %>;
  var buscando = false;

  async function carregarMais() {
    if (!hasMore || buscando) return;
    buscando = true;
    if (carregando) carregando.hidden = false;

    try {
      var res = await fetch('/api/posts-recentes?offset=' + offset + '&limit=8', {
        headers: { Accept: 'application/json' }
      });
      var data = await res.json();
      if (!data.ok) throw new Error('Falha ao carregar');

      if (data.html) {
        lista.insertAdjacentHTML('beforeend', data.html);
        offset = data.nextOffset || (offset + 8);
      }
      hasMore = !!data.hasMore;
      if (!hasMore) {
        sentinel.hidden = true;
        if (fimLista) fimLista.hidden = false;
      }
    } catch (e) {
      console.warn('home scroll:', e);
    } finally {
      buscando = false;
      if (carregando) carregando.hidden = true;
    }
  }

  if ('IntersectionObserver' in window && hasMore) {
    var obs = new IntersectionObserver(function (entries) {
      if (entries.some(function (e) { return e.isIntersecting; })) carregarMais();
    }, { rootMargin: '280px 0px' });
    obs.observe(sentinel);
  } else if (hasMore) {
    window.addEventListener('scroll', function () {
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 400) carregarMais();
    }, { passive: true });
  }
})();
</script>
<% } %>
