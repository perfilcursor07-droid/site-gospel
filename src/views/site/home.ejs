<section class="home-hero" style="--cor-primaria: <%= config.cor_primaria || '#ea580c' %>">
  <% if (principal) { %>
  <article class="home-destaque">
    <a href="/post/<%= principal.slug %>" class="home-destaque-link">
      <div class="home-destaque-media">
        <% if (principal.imagem) { %>
          <img src="<%= principal.imagem %>" alt="<%= principal.imagemAlt || principal.titulo %>" class="home-destaque-img">
        <% } else { %>
          <div class="home-destaque-img home-destaque-img--vazio" aria-hidden="true"></div>
        <% } %>
        <div class="home-destaque-overlay"></div>
      </div>
      <div class="home-destaque-conteudo">
        <% if (principal.categoria) { %>
          <span class="home-cat-badge" style="--cat-cor: <%= principal.categoria.corHex || '#ea580c' %>"><%= principal.categoria.nome %></span>
        <% } %>
        <h2 class="home-destaque-titulo"><%= principal.titulo %></h2>
        <% if (principal.resumo) { %>
          <p class="home-destaque-resumo"><%= principal.resumo %></p>
        <% } %>
        <% if (principal.publicadoEm) { %>
          <time class="home-destaque-data" datetime="<%= new Date(principal.publicadoEm).toISOString() %>">
            <%= new Date(principal.publicadoEm).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
          </time>
        <% } %>
      </div>
    </a>
  </article>

  <aside class="home-lateral" aria-label="Outras matérias em destaque">
    <div class="home-lateral-lista">
      <% laterais.forEach(function (post, i) { %>
        <article class="home-lateral-item">
          <a href="/post/<%= post.slug %>" class="home-lateral-link">
            <div class="home-lateral-corpo">
              <% if (post.categoria) { %>
                <span class="home-lateral-cat" style="color: <%= post.categoria.corHex || '#ea580c' %>"><%= post.categoria.nome %></span>
              <% } %>
              <h3 class="home-lateral-titulo"><%= post.titulo %></h3>
              <% if (post.resumo) { %>
                <p class="home-lateral-resumo"><%= post.resumo %></p>
              <% } %>
            </div>
            <% if (post.imagem) { %>
              <div class="home-lateral-thumb">
                <img src="<%= post.imagem %>" alt="<%= post.imagemAlt || post.titulo %>" loading="lazy">
              </div>
            <% } %>
          </a>
        </article>
      <% }) %>
      <% if (!laterais.length) { %>
        <p class="home-lateral-vazio">Nenhuma outra publicação.</p>
      <% } %>
    </div>
  </aside>
  <% } else { %>
  <div class="home-hero-vazio">
    <p>Nenhum post publicado ainda.</p>
  </div>
  <% } %>
</section>

<% if (typeof ultimasPublicacoes !== 'undefined' && ultimasPublicacoes.length) { %>
<section class="home-publicacoes mt-10 sm:mt-14" style="--cor-primaria: <%= config.cor_primaria || '#ea580c' %>">
  <h2 class="home-publicacoes-titulo">
    <span class="home-publicacoes-barra"></span> Últimas publicações
  </h2>
  <div class="home-publicacoes-lista">
    <% ultimasPublicacoes.forEach(function (post) { %>
      <article class="pub-item group">
        <a href="/post/<%= post.slug %>" class="pub-item-link">
          <div class="pub-item-thumb">
            <% if (post.imagem) { %>
              <img src="<%= post.imagem %>" alt="<%= post.imagemAlt || post.titulo %>" loading="lazy">
            <% } else { %>
              <span class="pub-item-thumb-vazio" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </span>
            <% } %>
          </div>
          <div class="pub-item-corpo">
            <% if (post.categoria) { %>
              <span class="pub-item-categoria" style="color: <%= post.categoria.corHex || '#ea580c' %>"><%= post.categoria.nome %></span>
            <% } %>
            <h3 class="pub-item-titulo"><%= post.titulo %></h3>
            <% if (post.resumo) { %>
              <p class="pub-item-resumo"><%= post.resumo %></p>
            <% } %>
            <p class="pub-item-meta">
              <% if (post.autor) { %><span>Por <%= post.autor.nome %></span><% } %>
              <% if (post.publicadoEm) { %><span><%= new Date(post.publicadoEm).toLocaleDateString('pt-BR') %></span><% } %>
            </p>
          </div>
        </a>
      </article>
    <% }) %>
  </div>
</section>
<% } %>
