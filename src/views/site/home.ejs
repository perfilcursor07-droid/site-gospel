<% if (destaques.length) { %>
<% const principal = destaques[0]; %>
<% const laterais = destaques.length > 1 ? destaques.slice(1, 5) : recentes.filter(function (p) { return p.id !== principal.id; }).slice(0, 4); %>
<section class="grid lg:grid-cols-3 gap-6 mb-10">
  <article class="lg:col-span-2 relative rounded-lg overflow-hidden bg-gray-900 min-h-[16rem] sm:min-h-[22rem] lg:min-h-[26rem] group">
    <a href="/post/<%= principal.slug %>" class="absolute inset-0">
      <% if (principal.imagem) { %>
        <img src="<%= principal.imagem %>" alt="<%= principal.titulo %>" class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:scale-105 transition duration-500">
      <% } %>
      <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6 pt-20 sm:pt-28 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
        <% if (principal.categoria) { %><span class="text-xs font-extrabold uppercase tracking-widest text-orange-400"><%= principal.categoria.nome %></span><% } %>
        <h1 class="mt-1 text-xl sm:text-2xl lg:text-4xl font-extrabold text-white leading-tight group-hover:underline"><%= principal.titulo %></h1>
        <% if (principal.resumo) { %><p class="mt-2 text-gray-200 text-sm lg:text-base line-clamp-2 hidden sm:block"><%= principal.resumo %></p><% } %>
      </div>
    </a>
  </article>

  <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100">
    <% laterais.forEach(function (post) { %>
      <article class="p-5 group">
        <a href="/post/<%= post.slug %>">
          <% if (post.categoria) { %><span class="text-xs font-extrabold uppercase tracking-widest text-orange-600"><%= post.categoria.nome %></span><% } %>
          <h2 class="mt-1 text-base font-extrabold leading-snug text-gray-900 group-hover:underline"><%= post.titulo %></h2>
        </a>
      </article>
    <% }) %>
  </div>
</section>
<% } %>

<section>
  <h2 class="flex items-center gap-3 text-lg font-extrabold uppercase tracking-wide text-gray-900 mb-5">
    <span class="w-1.5 h-6 bg-orange-600 rounded-full"></span> Últimas publicações
  </h2>
  <% if (recentes.length) { %>
  <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100">
    <% recentes.forEach(function (post) { %>
      <article class="group">
        <a href="/post/<%= post.slug %>" class="flex justify-between gap-3 sm:gap-5 p-4 sm:p-5">
          <div class="flex-1 min-w-0">
            <% if (post.categoria) { %><span class="text-xs font-extrabold uppercase tracking-widest text-orange-600"><%= post.categoria.nome %></span><% } %>
            <h3 class="mt-1 text-base sm:text-lg lg:text-xl font-extrabold leading-snug text-gray-900 group-hover:underline"><%= post.titulo %></h3>
            <% if (post.resumo) { %><p class="mt-1 text-sm text-gray-500 line-clamp-2 hidden sm:block"><%= post.resumo %></p><% } %>
            <p class="mt-2 sm:mt-3 text-xs text-gray-400">
              <% if (post.autor) { %>Por <%= post.autor.nome %><% } %>
              <% if (post.publicadoEm) { %> • <%= new Date(post.publicadoEm).toLocaleDateString('pt-BR') %><% } %>
            </p>
          </div>
          <% if (post.imagem) { %>
            <img src="<%= post.imagem %>" alt="<%= post.titulo %>" class="w-24 h-20 sm:w-32 sm:h-24 lg:w-44 lg:h-28 object-cover rounded flex-shrink-0">
          <% } %>
        </a>
      </article>
    <% }) %>
  </div>
  <% } else { %>
    <p class="bg-white rounded-lg border border-gray-200 p-6 text-gray-500">Nenhum post publicado ainda.</p>
  <% } %>
</section>
