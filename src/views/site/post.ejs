<% const corCategoria = post.categoria ? (post.categoria.corHex || '#ea580c') : '#ea580c'; %>

<section class="bg-white">
  <div class="max-w-6xl mx-auto px-3 sm:px-4 pt-2 sm:pt-4 pb-10">
    <nav class="max-w-4xl mx-auto mb-5 text-sm text-gray-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-700 transition">Início</a>
      <% if (post.categoria) { %>
        <span class="mx-1">›</span>
        <a href="/categoria/<%= post.categoria.slug %>" class="hover:text-gray-700 transition"><%= post.categoria.nome %></a>
      <% } %>
      <span class="mx-1">›</span>
      <span class="text-gray-500"><%= post.titulo %></span>
    </nav>

    <article class="max-w-4xl mx-auto">
      <% if (post.categoria) { %>
        <a href="/categoria/<%= post.categoria.slug %>" class="text-xs font-extrabold uppercase tracking-[0.18em] hover:underline" style="color: <%= corCategoria %>"><%= post.categoria.nome %></a>
      <% } %>
      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-gray-950"><%= post.titulo %></h1>
      <% if (post.resumo) { %><p class="mt-4 text-lg sm:text-xl leading-relaxed text-gray-500 max-w-3xl"><%= post.resumo %></p><% } %>

      <div class="post-meta-bar">
        <div class="post-meta-info">
          <% if (post.autor) { %>Por <span class="post-meta-autor"><%= post.autor.nome %></span><% } %>
          <% if (post.publicadoEm) { %>
            <% if (post.autor) { %><span class="post-meta-sep" aria-hidden="true">|</span><% } %>
            <time datetime="<%= new Date(post.publicadoEm).toISOString() %>"><%= new Date(post.publicadoEm).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></time>
          <% } %>
        </div>
        <div class="post-share" data-url="<%= urlAtual %>" data-titulo="<%= post.titulo %>">
          <span class="post-share-label">Compartilhe</span>
          <div class="post-share-buttons" role="group" aria-label="Compartilhar matéria">
            <a href="https://wa.me/?text=<%= encodeURIComponent(post.titulo + ' ' + urlAtual) %>" target="_blank" rel="noopener noreferrer"
              class="post-share-btn post-share-btn--whatsapp" aria-label="Compartilhar no WhatsApp" title="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(urlAtual) %>" target="_blank" rel="noopener noreferrer"
              class="post-share-btn post-share-btn--facebook" aria-label="Compartilhar no Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.titulo) %>&url=<%= encodeURIComponent(urlAtual) %>" target="_blank" rel="noopener noreferrer"
              class="post-share-btn post-share-btn--x" aria-label="Compartilhar no X" title="X">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <button type="button" class="post-share-btn post-share-btn--link" id="btn-copiar-link" aria-label="Copiar link da matéria" title="Copiar link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            </button>
          </div>
        </div>
      </div>

      <% if (post.imagem) { %>
        <figure class="post-capa mt-7">
          <div class="post-capa-imagem">
            <img src="<%= post.imagem %>" alt="<%= post.imagemAlt || post.titulo %>" class="w-full h-auto max-h-[34rem] object-contain mx-auto">
          </div>
          <% if (post.imagemAlt) { %>
            <figcaption class="post-capa-legenda"><%= post.imagemAlt %></figcaption>
          <% } %>
        </figure>
      <% } %>

      <div class="mt-8 max-w-none">
        <div class="post-conteudo max-w-none text-[1.06rem] leading-8 text-gray-700 [&_p]:mb-6 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:leading-tight [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-xl [&_h3]:font-bold [&_a]:text-primary [&_a]:underline-offset-2 hover:[&_a]:underline [&_strong]:font-extrabold [&_ul]:my-6 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-2 [&_blockquote]:my-8 [&_blockquote]:border-l-4 [&_blockquote]:border-primary [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-gray-600">
          <%- conteudoPartes.parte1 %>
        </div>

        <% if (typeof leiaMais !== 'undefined' && leiaMais.length) { %>
        <section class="post-leia-mais" style="--cor-categoria: <%= corCategoria %>">
          <h2 class="post-secao-titulo">
            <span class="post-secao-barra"></span> Leia mais
          </h2>
          <div class="post-leia-mais-grid">
            <% leiaMais.slice(0, 3).forEach(function (item) { %>
              <article class="post-leia-mais-card">
                <a href="/post/<%= item.slug %>" class="post-leia-mais-link">
                  <% if (item.categoria) { %>
                    <span class="post-leia-mais-categoria" style="color: <%= item.categoria.corHex || '#ea580c' %>"><%= item.categoria.nome %></span>
                  <% } %>
                  <h3 class="post-leia-mais-titulo"><%= item.titulo %></h3>
                </a>
              </article>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% if (conteudoPartes.parte2) { %>
        <div class="post-conteudo max-w-none text-[1.06rem] leading-8 text-gray-700 [&_p]:mb-6 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:leading-tight [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-xl [&_h3]:font-bold [&_a]:text-primary [&_a]:underline-offset-2 hover:[&_a]:underline [&_strong]:font-extrabold [&_ul]:my-6 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-2 [&_blockquote]:my-8 [&_blockquote]:border-l-4 [&_blockquote]:border-primary [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-gray-600">
          <%- conteudoPartes.parte2 %>
        </div>
        <% } %>
      </div>

      <section id="comentarios" class="post-comentarios" style="--cor-categoria: <%= corCategoria %>">
        <h2 class="post-comentarios-titulo">
          <span class="post-secao-barra"></span>
          Comentários
          <% if (comentarios.length) { %><span class="post-comentarios-qtd">(<%= comentarios.length %>)</span><% } %>
        </h2>

        <% if (comentarios.length) { %>
          <ul class="post-comentarios-lista">
            <% comentarios.forEach(function (c) { %>
              <li class="post-comentario-item">
                <div class="post-comentario-cabecalho">
                  <strong class="post-comentario-autor"><%= c.nome %></strong>
                  <time datetime="<%= new Date(c.createdAt).toISOString() %>">
                    <%= new Date(c.createdAt).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </time>
                </div>
                <p class="post-comentario-texto"><%= c.conteudo %></p>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="post-comentarios-vazio">Seja o primeiro a comentar esta matéria.</p>
        <% } %>

        <div class="post-comentarios-form-wrap<%= (typeof mensagens !== 'undefined' && mensagens.erro && mensagens.erro.length) ? ' is-aberto' : '' %>" id="wrap-form-comentario">
          <button type="button" class="post-comentarios-toggle" id="btn-toggle-comentario" aria-expanded="<%= (typeof mensagens !== 'undefined' && mensagens.erro && mensagens.erro.length) ? 'true' : 'false' %>" aria-controls="form-comentario-corpo">
            <span>Deixe seu comentário</span>
            <svg class="post-comentarios-toggle-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="form-comentario-corpo" class="post-comentarios-form-corpo"<%= (typeof mensagens !== 'undefined' && mensagens.erro && mensagens.erro.length) ? '' : ' hidden' %>>
          <form action="/post/<%= post.slug %>/comentario" method="post" class="post-comentarios-form">
            <div class="post-comentarios-campos">
              <label class="post-comentarios-label">
                Nome
                <input type="text" name="nome" required maxlength="80" placeholder="Seu nome" autocomplete="name">
              </label>
              <label class="post-comentarios-label">
                E-mail
                <input type="email" name="email" required maxlength="120" placeholder="seu@email.com" autocomplete="email">
              </label>
            </div>
            <label class="post-comentarios-label">
              Comentário
              <textarea name="conteudo" rows="4" required minlength="5" maxlength="2000" placeholder="Escreva seu comentário..."></textarea>
            </label>
            <div class="post-comentarios-captcha">
              <label class="post-comentarios-label">
                Pergunta de segurança: <strong><%= captchaPergunta %></strong>
                <input type="number" name="resposta_captcha" required inputmode="numeric" placeholder="Sua resposta" autocomplete="off">
              </label>
              <p class="post-comentarios-captcha-dica">Responda para confirmar que você não é um robô.</p>
            </div>
            <div class="post-comentarios-honeypot" aria-hidden="true">
              <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <button type="submit" class="post-comentarios-btn">Publicar comentário</button>
          </form>
          </div>
        </div>
      </section>
    </article>
  </div>
</section>

<% if (typeof relacionados !== 'undefined' && relacionados.length) { %>
<section class="bg-white border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-3 sm:px-4 py-10">
    <h2 class="post-secao-titulo mb-6" style="--cor-categoria: <%= corCategoria %>">
      <span class="post-secao-barra"></span> Matérias relacionadas
    </h2>
    <div class="post-relacionados-grid">
      <% relacionados.slice(0, 6).forEach(function (rel) { %>
        <article class="post-relacionados-card group">
          <a href="/post/<%= rel.slug %>" class="post-relacionados-thumb">
            <% if (rel.imagem) { %>
              <img src="<%= rel.imagem %>" alt="<%= rel.imagemAlt || rel.titulo %>">
            <% } else { %>
              <span class="post-relacionados-thumb-vazio" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </span>
            <% } %>
          </a>
          <div class="post-relacionados-corpo">
            <% if (rel.categoria) { %>
              <span class="post-relacionados-categoria" style="color: <%= rel.categoria.corHex || '#ea580c' %>"><%= rel.categoria.nome %></span>
            <% } %>
            <h3 class="post-relacionados-titulo">
              <a href="/post/<%= rel.slug %>" class="group-hover:underline"><%= rel.titulo %></a>
            </h3>
            <% if (rel.resumo) { %>
              <p class="post-relacionados-resumo"><%= rel.resumo %></p>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<script>
(function () {
  var btnCopiar = document.getElementById('btn-copiar-link');
  var share = document.querySelector('.post-share');
  if (btnCopiar && share) {
    btnCopiar.addEventListener('click', function () {
      var url = share.dataset.url || window.location.href;

      function feedback() {
        btnCopiar.classList.add('is-copied');
        btnCopiar.setAttribute('title', 'Link copiado!');
        setTimeout(function () {
          btnCopiar.classList.remove('is-copied');
          btnCopiar.setAttribute('title', 'Copiar link');
        }, 2000);
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(feedback).catch(function () {
          window.prompt('Copie o link:', url);
        });
      } else {
        window.prompt('Copie o link:', url);
      }
    });
  }

  var wrapForm = document.getElementById('wrap-form-comentario');
  var btnToggle = document.getElementById('btn-toggle-comentario');
  var corpoForm = document.getElementById('form-comentario-corpo');

  function definirFormComentario(aberto) {
    if (!wrapForm || !btnToggle || !corpoForm) return;
    wrapForm.classList.toggle('is-aberto', aberto);
    btnToggle.setAttribute('aria-expanded', String(aberto));
    corpoForm.hidden = !aberto;
    if (aberto) {
      var primeiro = corpoForm.querySelector('input, textarea');
      if (primeiro) window.setTimeout(function () { primeiro.focus(); }, 80);
    }
  }

  if (btnToggle && corpoForm) {
    btnToggle.addEventListener('click', function () {
      definirFormComentario(corpoForm.hidden);
    });
  }
})();
</script>
