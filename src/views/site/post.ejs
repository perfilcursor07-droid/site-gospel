<article class="post-completo">
  <% if (post.categoria) { %>
    <a class="badge" href="/categoria/<%= post.categoria.slug %>"><%= post.categoria.nome %></a>
  <% } %>
  <h1><%= post.titulo %></h1>
  <p class="meta">
    <% if (post.autor) { %>Por <%= post.autor.nome %> • <% } %>
    <% if (post.publicadoEm) { %><%= new Date(post.publicadoEm).toLocaleDateString('pt-BR') %><% } %>
  </p>
  <% if (post.imagem) { %><img class="imagem-destaque" src="<%= post.imagem %>" alt="<%= post.titulo %>"><% } %>
  <div class="conteudo-post">
    <%- post.conteudo %>
  </div>
</article>
