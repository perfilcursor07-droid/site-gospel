<div class="page-header">
  <h1>Páginas</h1>
  <a href="/admin/paginas/nova" class="btn btn-primario">+ Nova página</a>
</div>
<table class="tabela">
  <thead><tr><th>Título</th><th>Slug</th><th>Status</th><th>Ações</th></tr></thead>
  <tbody>
    <% paginas.forEach(function (pagina) { %>
    <tr>
      <td><%= pagina.titulo %></td>
      <td>/pagina/<%= pagina.slug %></td>
      <td><span class="badge badge-<%= pagina.status %>"><%= pagina.status %></span></td>
      <td class="acoes">
        <a href="/admin/paginas/<%= pagina.id %>/editar" class="btn btn-sec">Editar</a>
        <form action="/admin/paginas/<%= pagina.id %>/excluir" method="post" onsubmit="return confirm('Excluir esta página?')">
          <button class="btn btn-perigo">Excluir</button>
        </form>
      </td>
    </tr>
    <% }) %>
    <% if (!paginas.length) { %><tr><td colspan="4">Nenhuma página encontrada.</td></tr><% } %>
  </tbody>
</table>
