<div class="config-page">
  <header class="config-header">
    <div>
      <h1>Configurações</h1>
      <p class="config-header-desc">Identidade do site, SEO, integrações Google e indexação.</p>
    </div>
  </header>

  <details class="config-ia-fold">
    <summary>Preencher campos com IA (DeepSeek)</summary>
    <div class="config-ia-corpo">
      <p class="dica">Descreva seu portal gospel e a IA sugere textos para Identidade, SEO e Rodapé. Revise antes de salvar.</p>
      <label class="config-label" for="ia-config-descricao">Sobre o seu site</label>
      <textarea id="ia-config-descricao" class="ia-input-grande" rows="2" placeholder="Ex.: Site gospel com notícias, louvor e igrejas no Brasil. Público evangélico jovem e adulto."></textarea>
      <div class="config-ia-botoes">
        <button type="button" class="btn btn-primario btn-sm" id="btn-ia-config-todas">Preencher tudo</button>
        <button type="button" class="btn btn-sec btn-sm" id="btn-ia-config-identidade">Identidade</button>
        <button type="button" class="btn btn-sec btn-sm" id="btn-ia-config-seo">SEO</button>
        <button type="button" class="btn btn-sec btn-sm" id="btn-ia-config-rodape">Rodapé</button>
      </div>
      <p class="ia-status-msg ia-status-info" id="ia-config-status" hidden></p>
    </div>
  </details>

  <form action="/admin/configuracoes" method="post" enctype="multipart/form-data" class="config-layout form form-largo" id="form-config">

    <nav class="config-nav" id="config-nav" aria-label="Seções de configuração">
      <p class="config-nav-grupo">Site</p>
      <button type="button" class="config-nav-btn ativa" data-aba="identidade">Identidade</button>
      <button type="button" class="config-nav-btn" data-aba="redes">Redes sociais</button>
      <button type="button" class="config-nav-btn" data-aba="rodape">Rodapé</button>

      <p class="config-nav-grupo">Busca</p>
      <button type="button" class="config-nav-btn" data-aba="seo">SEO</button>
      <button type="button" class="config-nav-btn" data-aba="sitemap">Sitemap & indexação</button>

      <p class="config-nav-grupo">Integrações</p>
      <button type="button" class="config-nav-btn" data-aba="google">Google & anúncios</button>
      <button type="button" class="config-nav-btn" data-aba="amp">AMP (mobile)</button>
    </nav>

    <div class="config-corpo">

      <!-- IDENTIDADE -->
      <div class="config-painel" data-aba="identidade">
        <div class="config-painel-topo">
          <div>
            <h2>Identidade</h2>
            <p class="dica">Nome, visual e cores exibidos em todo o site.</p>
          </div>
          <button type="button" class="btn btn-sec btn-sm btn-ia-aba" data-ia-secao="identidade">✨ IA</button>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Informações básicas</h3>
          <div class="config-campos">
            <label>Nome do site
              <input type="text" name="site_nome" value="<%= config.site_nome || '' %>" placeholder="Site Gospel">
            </label>
            <label>Slogan / tagline
              <input type="text" name="site_slogan" value="<%= config.site_slogan || '' %>" placeholder="Notícias, louvor e edificação">
            </label>
            <label>Descrição do site
              <textarea name="site_descricao" rows="2" placeholder="Breve descrição do site"><%= config.site_descricao || '' %></textarea>
            </label>
          </div>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Visual</h3>
          <div class="config-grid-2">
            <div class="campo-upload">
              <label>Logomarca<input type="file" name="logo" accept="image/*"></label>
              <% if (config.logo) { %>
                <img src="<%= config.logo %>" alt="Logomarca" class="preview-img preview-logo">
                <label class="checkbox"><input type="checkbox" name="remover_logo"> Remover logo</label>
              <% } %>
            </div>
            <div class="campo-upload">
              <label>Favicon<input type="file" name="favicon" accept="image/*"></label>
              <% if (config.favicon) { %>
                <img src="<%= config.favicon %>" alt="Favicon" class="preview-img preview-favicon">
                <label class="checkbox"><input type="checkbox" name="remover_favicon"> Remover favicon</label>
              <% } %>
              <p class="dica">Quadrado, 32×32 ou 64×64 px.</p>
            </div>
          </div>
          <label>Cor primária
            <input type="color" name="cor_primaria" value="<%= config.cor_primaria || '#ea580c' %>" class="input-cor">
          </label>
        </div>
      </div>

      <!-- REDES -->
      <div class="config-painel" data-aba="redes" hidden>
        <div class="config-painel-topo">
          <div>
            <h2>Redes sociais</h2>
            <p class="dica">Links exibidos no rodapé do site. Deixe em branco para ocultar.</p>
          </div>
        </div>
        <div class="config-card">
          <div class="config-campos">
            <label>Facebook<input type="url" name="social_facebook" value="<%= config.social_facebook || '' %>" placeholder="https://facebook.com/seusite"></label>
            <label>Instagram<input type="url" name="social_instagram" value="<%= config.social_instagram || '' %>" placeholder="https://instagram.com/seusite"></label>
            <label>YouTube<input type="url" name="social_youtube" value="<%= config.social_youtube || '' %>" placeholder="https://youtube.com/@seusite"></label>
            <label>WhatsApp<input type="url" name="social_whatsapp" value="<%= config.social_whatsapp || '' %>" placeholder="https://wa.me/5511999999999"></label>
          </div>
        </div>
      </div>

      <!-- RODAPÉ -->
      <div class="config-painel" data-aba="rodape" hidden>
        <div class="config-painel-topo">
          <div>
            <h2>Rodapé</h2>
            <p class="dica">Copyright e links extras. Páginas do admin aparecem automaticamente.</p>
          </div>
          <button type="button" class="btn btn-sec btn-sm btn-ia-aba" data-ia-secao="rodape">✨ IA</button>
        </div>
        <div class="config-card">
          <div class="config-campos">
            <label>Texto do copyright
              <input type="text" name="footer_copyright" value="<%= config.footer_copyright || '' %>" placeholder="© 2026 Site Gospel. Todos os direitos reservados.">
            </label>
            <label>Links extras (um por linha: Texto|URL)
              <textarea name="footer_links" rows="4" placeholder="Busca|/busca"><%= config.footer_links || '' %></textarea>
            </label>
          </div>
        </div>
      </div>

      <!-- SEO -->
      <div class="config-painel" data-aba="seo" hidden>
        <div class="config-painel-topo">
          <div>
            <h2>SEO</h2>
            <p class="dica">Como o site aparece no Google e ao compartilhar links.</p>
          </div>
          <button type="button" class="btn btn-sec btn-sm btn-ia-aba" data-ia-secao="seo">✨ IA</button>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Meta tags</h3>
          <div class="config-campos">
            <label>Título SEO da home
              <input type="text" name="seo_titulo" maxlength="60" value="<%= config.seo_titulo || '' %>" data-contador="cont-titulo" data-snippet="snippet-titulo" placeholder="Site Gospel — Notícias e louvor">
            </label>
            <p class="dica"><span id="cont-titulo">0</span>/60 caracteres</p>
            <label>Meta descrição
              <textarea name="seo_descricao" rows="2" maxlength="160" data-contador="cont-desc" data-snippet="snippet-desc" placeholder="Descrição nos resultados do Google"><%= config.seo_descricao || '' %></textarea>
            </label>
            <p class="dica"><span id="cont-desc">0</span>/160 caracteres</p>
            <label>Palavras-chave
              <input type="text" name="seo_palavras_chave" value="<%= config.seo_palavras_chave || '' %>" placeholder="gospel, louvor, estudos bíblicos">
            </label>
          </div>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Compartilhamento & indexação</h3>
          <div class="campo-upload">
            <label>Imagem Open Graph (redes sociais)<input type="file" name="og_imagem" accept="image/*"></label>
            <% if (config.og_imagem) { %><img src="<%= config.og_imagem %>" alt="OG" class="preview-img preview-og"><% } %>
            <p class="dica">Recomendado: 1200×630 px.</p>
          </div>
          <label class="checkbox">
            <input type="checkbox" name="seo_indexar" <%= (config.seo_indexar || 'sim') !== 'nao' ? 'checked' : '' %>>
            Permitir indexação no Google
          </label>
          <p class="dica">Desligado = noindex + bloqueio no robots.txt.</p>
        </div>

        <div class="config-card config-card--preview">
          <h3 class="config-card-titulo">Prévia no Google</h3>
          <div class="snippet-google">
            <p class="snippet-url"><%= urlBase %></p>
            <p class="snippet-titulo" id="snippet-titulo"><%= config.seo_titulo || config.site_nome || 'Site Gospel' %></p>
            <p class="snippet-desc" id="snippet-desc"><%= config.seo_descricao || 'A meta descrição aparecerá aqui.' %></p>
          </div>
        </div>
      </div>

      <!-- GOOGLE -->
      <div class="config-painel" data-aba="google" hidden>
        <div class="config-painel-topo">
          <div>
            <h2>Google & anúncios</h2>
            <p class="dica">Search Console, Analytics, AdSense e scripts no head.</p>
          </div>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Ferramentas Google</h3>
          <div class="config-campos">
            <label>Search Console (meta verification)
              <input type="text" name="google_site_verification" value="<%= config.google_site_verification || '' %>" placeholder="Conteúdo da meta google-site-verification">
            </label>
            <label>Google Analytics
              <input type="text" name="google_analytics" value="<%= config.google_analytics || '' %>" placeholder="G-XXXXXXXXXX">
            </label>
          </div>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Google AdSense</h3>
          <label>Script do AdSense
            <textarea name="google_adsense" rows="4" placeholder="&lt;script async src=&quot;...adsbygoogle.js?client=ca-pub-XXXX&quot;...&gt;"><%= config.google_adsense || '' %></textarea>
          </label>
          <label>ID do cliente (ca-pub-…)
            <input type="text" name="google_adsense_client" value="<%= config.google_adsense_client || '' %>" placeholder="ca-pub-XXXXXXXXXXXXXXXX">
          </label>
          <p class="dica">Inserido no &lt;head&gt; de todas as páginas. O ID também alimenta páginas AMP.</p>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Scripts extras</h3>
          <label>Código customizado no &lt;head&gt;
            <textarea name="head_custom" rows="4" placeholder="Tags ou scripts adicionais"><%= config.head_custom || '' %></textarea>
          </label>
          <p class="dica config-alerta">Inserido sem filtro no site público — use com cuidado.</p>
        </div>
      </div>

      <!-- AMP -->
      <div class="config-painel" data-aba="amp" hidden>
        <div class="config-painel-topo">
          <div>
            <h2>AMP (mobile)</h2>
            <p class="dica">Versões aceleradas dos posts para celular.</p>
          </div>
        </div>

        <div class="config-card">
          <label class="checkbox">
            <input type="checkbox" name="amp_habilitado" <%= config.amp_habilitado === 'sim' ? 'checked' : '' %>>
            Habilitar AMP para posts publicados
          </label>
          <label class="checkbox">
            <input type="checkbox" name="amp_adsense" <%= (config.amp_adsense || 'sim') !== 'nao' ? 'checked' : '' %>>
            Exibir AdSense nas páginas AMP
          </label>
          <p class="dica">URL: <code>/post/slug/amp</code> · Canônica aponta para a versão completa.</p>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Logo no header AMP</h3>
          <div class="amp-logo-config-grid">
            <label>Largura (px)<input type="number" name="amp_logo_largura" min="60" max="320" value="<%= config.amp_logo_largura || '140' %>"></label>
            <label>Altura (px)<input type="number" name="amp_logo_altura" min="20" max="120" value="<%= config.amp_logo_altura || '42' %>"></label>
            <label>Texto sem logo (rem)<input type="number" name="amp_logo_texto_tamanho" min="0.85" max="2" step="0.05" value="<%= config.amp_logo_texto_tamanho || '1.1' %>"></label>
          </div>
          <% if (config.logo) { %>
            <div class="amp-logo-preview">
              <span>Prévia</span>
              <img src="<%= config.logo %>" alt="Logo AMP" style="max-width:<%= config.amp_logo_largura || 140 %>px;max-height:<%= config.amp_logo_altura || 42 %>px">
            </div>
          <% } %>
        </div>

        <div class="config-card config-card--info">
          <a href="https://search.google.com/test/amp" target="_blank" rel="noopener" class="btn btn-sec btn-sm">Validar AMP no Google</a>
        </div>
      </div>

      <!-- SITEMAP -->
      <div class="config-painel" data-aba="sitemap" hidden>
        <div class="config-painel-topo">
          <div>
            <h2>Sitemap & indexação</h2>
            <p class="dica">URLs para o Google, avisos automáticos e IndexNow.</p>
          </div>
        </div>

        <% if (!sitemap.indexar) { %>
          <p class="sitemap-alerta">Indexação desligada na aba SEO. Ative “Permitir indexação no Google”.</p>
        <% } %>
        <% if (sitemap.erro) { %>
          <p class="sitemap-alerta">Erro ao carregar sitemap: <%= sitemap.erro %></p>
        <% } %>

        <div class="config-card">
          <h3 class="config-card-titulo">Resumo</h3>
          <div class="sitemap-stats">
            <div class="sitemap-stat"><strong><%= sitemap.contagem.total %></strong><span>URLs</span></div>
            <div class="sitemap-stat"><strong><%= sitemap.contagem.posts %></strong><span>Posts</span></div>
            <div class="sitemap-stat"><strong><%= sitemap.contagem.categorias %></strong><span>Categorias</span></div>
            <div class="sitemap-stat"><strong><%= sitemap.contagem.paginas %></strong><span>Páginas</span></div>
            <div class="sitemap-stat"><strong><%= sitemap.contagem.news %></strong><span>News 48h</span></div>
          </div>
          <label style="margin-top:14px">URL canônica (produção)
            <input type="url" name="sitemap_url_canonica" value="<%= config.sitemap_url_canonica || '' %>" placeholder="https://www.seusite.com.br">
          </label>
          <p class="dica">Em branco = domínio atual. Use HTTPS em produção.</p>
        </div>

        <div class="config-card">
          <h3 class="config-card-titulo">Links do sitemap</h3>
          <% sitemap.sitemaps.forEach(function (item) { %>
            <div class="sitemap-link-item">
              <span class="sitemap-link-tipo"><%= item.tipo === 'google-news' ? 'News' : 'Principal' %></span>
              <input type="text" class="sitemap-link-campo" value="<%= item.loc %>" readonly>
              <button type="button" class="btn btn-sec btn-sm btn-copiar" data-copiar-alvo="<%= item.loc %>">Copiar</button>
              <a href="<%= item.loc %>" target="_blank" rel="noopener" class="btn btn-sec btn-sm">Abrir</a>
            </div>
          <% }) %>
          <div class="sitemap-link-item">
            <span class="sitemap-link-tipo">robots</span>
            <input type="text" class="sitemap-link-campo" value="<%= sitemap.robotsUrl %>" readonly>
            <button type="button" class="btn btn-sec btn-sm btn-copiar" data-copiar-alvo="<%= sitemap.robotsUrl %>">Copiar</button>
            <a href="<%= sitemap.robotsUrl %>" target="_blank" rel="noopener" class="btn btn-sec btn-sm">Abrir</a>
          </div>
          <div class="sitemap-acoes-google" style="margin-top:12px">
            <a href="<%= sitemap.googleSearchConsoleUrl %>" target="_blank" rel="noopener" class="btn btn-primario btn-sm">Search Console</a>
            <% if (sitemap.googleSitemapPingUrl) { %>
              <a href="<%= sitemap.googleSitemapPingUrl %>" target="_blank" rel="noopener" class="btn btn-sec btn-sm">Ping sitemap</a>
            <% } %>
          </div>
        </div>

        <details class="config-fold">
          <summary>Google Indexing API</summary>
          <div class="config-fold-corpo">
            <% if (typeof googleIndexing !== 'undefined' && googleIndexing.configurado) { %>
              <p class="dica"><strong>Conta:</strong> <code><%= googleIndexing.email || '—' %></code></p>
              <p class="dica">Cota hoje: <strong><%= googleIndexing.quota.enviados %></strong>/<%= googleIndexing.quotaMax %> · restam <strong><%= googleIndexing.quota.restantes %></strong></p>
            <% } else { %>
              <p class="sitemap-alerta">Coloque <code>config/google-indexing-key.json</code> e adicione a conta como Proprietário no Search Console.</p>
            <% } %>
            <label class="checkbox">
              <input type="checkbox" name="google_indexing_ativo" <%= (config.google_indexing_ativo || 'nao') === 'sim' ? 'checked' : '' %>>
              Enviar ao Google automaticamente ao publicar post
            </label>
            <div class="config-ia-botoes" style="margin-top:10px">
              <label>Posts a enviar
                <select id="google-indexing-limite">
                  <option value="10">10</option>
                  <option value="30" selected>30</option>
                  <option value="50">50</option>
                  <option value="100">100</option>
                  <option value="200">200</option>
                </select>
              </label>
              <button type="button" class="btn btn-sec btn-sm" id="btn-google-indexing-testar">Testar</button>
              <button type="button" class="btn btn-primario btn-sm" id="btn-google-indexing-enviar">Enviar lote</button>
            </div>
            <p id="google-indexing-resultado" class="dica" style="margin-top:8px"></p>
          </div>
        </details>

        <details class="config-fold">
          <summary>IndexNow</summary>
          <div class="config-fold-corpo">
            <label>Chave IndexNow
              <input type="text" name="indexnow_chave" value="<%= config.indexnow_chave || '' %>" readonly>
            </label>
            <button type="submit" class="btn btn-sec btn-sm" name="gerar_indexnow" value="1">Gerar nova chave</button>
            <% if (config.indexnow_chave && sitemap.base) { %>
              <p class="dica"><code><%= sitemap.base %>/<%= config.indexnow_chave %>.txt</code><% if (sitemap.indexnowAtivo) { %> — ativo<% } %></p>
            <% } %>
          </div>
        </details>

        <details class="config-fold">
          <summary>Opções do sitemap</summary>
          <div class="config-fold-corpo">
            <label class="checkbox"><input type="checkbox" name="sitemap_incluir_home" <%= (config.sitemap_incluir_home || 'sim') !== 'nao' ? 'checked' : '' %>> Página inicial</label>
            <label class="checkbox"><input type="checkbox" name="sitemap_incluir_posts" <%= (config.sitemap_incluir_posts || 'sim') !== 'nao' ? 'checked' : '' %>> Posts publicados</label>
            <label class="checkbox"><input type="checkbox" name="sitemap_incluir_categorias" <%= (config.sitemap_incluir_categorias || 'sim') !== 'nao' ? 'checked' : '' %>> Categorias</label>
            <label class="checkbox"><input type="checkbox" name="sitemap_incluir_paginas" <%= (config.sitemap_incluir_paginas || 'sim') !== 'nao' ? 'checked' : '' %>> Páginas institucionais</label>
            <label class="checkbox"><input type="checkbox" name="sitemap_news_ativo" <%= config.sitemap_news_ativo === 'sim' ? 'checked' : '' %>> Google News (posts 48h)</label>
            <div class="sitemap-frequencias" style="margin-top:12px">
              <label>Freq. home<select name="sitemap_changefreq_home"><% ['daily','weekly','monthly'].forEach(function (op) { %><option value="<%= op %>" <%= (config.sitemap_changefreq_home || 'daily') === op ? 'selected' : '' %>><%= op %></option><% }) %></select></label>
              <label>Freq. posts<select name="sitemap_changefreq_posts"><% ['daily','weekly','monthly'].forEach(function (op) { %><option value="<%= op %>" <%= (config.sitemap_changefreq_posts || 'daily') === op ? 'selected' : '' %>><%= op %></option><% }) %></select></label>
              <label>Freq. categorias<select name="sitemap_changefreq_categorias"><% ['daily','weekly','monthly'].forEach(function (op) { %><option value="<%= op %>" <%= (config.sitemap_changefreq_categorias || 'weekly') === op ? 'selected' : '' %>><%= op %></option><% }) %></select></label>
              <label>Freq. páginas<select name="sitemap_changefreq_paginas"><% ['weekly','monthly','yearly'].forEach(function (op) { %><option value="<%= op %>" <%= (config.sitemap_changefreq_paginas || 'monthly') === op ? 'selected' : '' %>><%= op %></option><% }) %></select></label>
            </div>
          </div>
        </details>

        <% if (sitemap.amostra.length) { %>
          <details class="config-fold">
            <summary>Prévia de URLs (<%= sitemap.amostra.length %>)</summary>
            <div class="config-fold-corpo sitemap-amostra">
              <ul><% sitemap.amostra.forEach(function (url) { %><li><code><%= url %></code></li><% }) %></ul>
            </div>
          </details>
        <% } %>
      </div>

      <div class="config-acoes">
        <button type="submit" class="btn btn-primario">Salvar configurações</button>
      </div>
    </div>
  </form>
</div>

<script>
(function () {
  var navBtns = document.querySelectorAll('.config-nav-btn');
  var paineis = document.querySelectorAll('.config-painel');

  function irAba(id) {
    navBtns.forEach(function (b) { b.classList.toggle('ativa', b.dataset.aba === id); });
    paineis.forEach(function (p) { p.hidden = p.dataset.aba !== id; });
    try { history.replaceState(null, '', '#'+id); } catch (e) {}
  }

  navBtns.forEach(function (btn) {
    btn.addEventListener('click', function () { irAba(btn.dataset.aba); });
  });

  var hash = (location.hash || '').replace('#', '');
  if (hash === 'google') hash = 'google';
  if (hash && document.querySelector('.config-nav-btn[data-aba="'+hash+'"]')) irAba(hash);

  document.querySelectorAll('[data-contador]').forEach(function (campo) {
    var contador = document.getElementById(campo.dataset.contador);
    var snippet = campo.dataset.snippet ? document.getElementById(campo.dataset.snippet) : null;
    function atualizar() {
      if (contador) contador.textContent = campo.value.length;
      if (snippet && campo.value.trim()) snippet.textContent = campo.value;
    }
    campo.addEventListener('input', atualizar);
    atualizar();
  });

  document.querySelectorAll('.btn-copiar').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var texto = btn.dataset.copiarAlvo || '';
      if (!texto) return;
      navigator.clipboard.writeText(texto).then(function () {
        var ant = btn.textContent;
        btn.textContent = 'Copiado!';
        setTimeout(function () { btn.textContent = ant; }, 1500);
      });
    });
  });

  var btnGiTestar = document.getElementById('btn-google-indexing-testar');
  var btnGiEnviar = document.getElementById('btn-google-indexing-enviar');
  var giResultado = document.getElementById('google-indexing-resultado');
  var giLimite = document.getElementById('google-indexing-limite');

  function giStatus(msg, tipo) {
    if (!giResultado) return;
    giResultado.textContent = msg;
    giResultado.style.color = tipo === 'erro' ? '#b91c1c' : tipo === 'ok' ? '#15803d' : '#6b7280';
  }

  if (btnGiTestar) {
    btnGiTestar.addEventListener('click', async function () {
      btnGiTestar.disabled = true;
      giStatus('Testando...', 'info');
      try {
        var res = await fetch('/admin/configuracoes/google-indexing/testar', { method: 'POST' });
        var data = await res.json();
        giStatus(data.ok ? data.mensagem + ' Restam: ' + data.quota.restantes : (data.erro || 'Falha'), data.ok ? 'ok' : 'erro');
      } catch (e) { giStatus(e.message, 'erro'); }
      finally { btnGiTestar.disabled = false; }
    });
  }

  if (btnGiEnviar) {
    btnGiEnviar.addEventListener('click', async function () {
      if (!confirm('Enviar posts recentes ao Google?')) return;
      btnGiEnviar.disabled = true;
      giStatus('Enviando...', 'info');
      try {
        var res = await fetch('/admin/configuracoes/google-indexing/enviar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ limite: giLimite ? giLimite.value : 30 })
        });
        var data = await res.json();
        giStatus(data.ok ? data.mensagem : (data.erro || 'Erro'), data.ok ? 'ok' : 'erro');
      } catch (e) { giStatus(e.message, 'erro'); }
      finally { btnGiEnviar.disabled = false; }
    });
  }

  var iaDescricao = document.getElementById('ia-config-descricao');
  var iaStatus = document.getElementById('ia-config-status');
  var iaBotoes = ['btn-ia-config-todas','btn-ia-config-identidade','btn-ia-config-seo','btn-ia-config-rodape'].map(function (id) { return document.getElementById(id); });

  function mostrarStatusIa(texto, tipo) {
    if (!iaStatus) return;
    iaStatus.hidden = !texto;
    iaStatus.textContent = texto || '';
    iaStatus.className = 'ia-status-msg ia-status-' + (tipo || 'info');
  }

  function preencherCampo(nome, valor) {
    if (valor == null || valor === '') return;
    var el = document.querySelector('[name="' + nome + '"]');
    if (!el) return;
    el.value = valor;
    el.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function aplicarSugestoes(s) {
    var id = s.identidade || {}, seo = s.seo || {}, rod = s.rodape || {};
    preencherCampo('site_nome', id.site_nome);
    preencherCampo('site_slogan', id.site_slogan);
    preencherCampo('site_descricao', id.site_descricao);
    preencherCampo('cor_primaria', id.cor_primaria);
    preencherCampo('seo_titulo', seo.seo_titulo);
    preencherCampo('seo_descricao', seo.seo_descricao);
    preencherCampo('seo_palavras_chave', seo.seo_palavras_chave);
    preencherCampo('footer_copyright', rod.footer_copyright);
    preencherCampo('footer_links', rod.footer_links);
  }

  function setCarregandoIa(ativo) {
    iaBotoes.forEach(function (b) { if (b) b.disabled = ativo; });
    document.querySelectorAll('.btn-ia-aba').forEach(function (b) { b.disabled = ativo; });
    if (iaDescricao) iaDescricao.disabled = ativo;
  }

  async function solicitarSugestaoIa(secao) {
    var descricao = (iaDescricao && iaDescricao.value || '').trim();
    if (descricao.length < 10) {
      mostrarStatusIa('Descreva o site com pelo menos 10 caracteres.', 'aviso');
      if (iaDescricao) iaDescricao.focus();
      return;
    }
    setCarregandoIa(true);
    mostrarStatusIa('Gerando sugestões...', 'info');
    try {
      var res = await fetch('/admin/configuracoes/ia-sugerir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ descricao: descricao, secao: secao || 'todas' })
      });
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.erro || 'Erro ao gerar.');
      aplicarSugestoes(data.sugestoes);
      mostrarStatusIa('Campos preenchidos! Revise e salve.', 'sucesso');
      if (secao === 'identidade') irAba('identidade');
      if (secao === 'seo') irAba('seo');
      if (secao === 'rodape') irAba('rodape');
    } catch (e) { mostrarStatusIa(e.message, 'erro'); }
    finally { setCarregandoIa(false); }
  }

  var btnTodas = document.getElementById('btn-ia-config-todas');
  if (btnTodas) {
    btnTodas.addEventListener('click', function () { solicitarSugestaoIa('todas'); });
    document.getElementById('btn-ia-config-identidade').addEventListener('click', function () { solicitarSugestaoIa('identidade'); });
    document.getElementById('btn-ia-config-seo').addEventListener('click', function () { solicitarSugestaoIa('seo'); });
    document.getElementById('btn-ia-config-rodape').addEventListener('click', function () { solicitarSugestaoIa('rodape'); });
    document.querySelectorAll('.btn-ia-aba').forEach(function (btn) {
      btn.addEventListener('click', function () { solicitarSugestaoIa(btn.dataset.iaSecao); });
    });
  }
})();
</script>
