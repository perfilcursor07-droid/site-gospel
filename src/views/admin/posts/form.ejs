<h1><%= post ? 'Editar post' : 'Novo post' %></h1>
<form action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>" method="post" enctype="multipart/form-data" class="form">
  <label>Título
    <input type="text" name="titulo" value="<%= post ? post.titulo : '' %>" required>
  </label>
  <label>Resumo
    <textarea name="resumo" rows="2"><%= post ? (post.resumo || '') : '' %></textarea>
  </label>
  <label>Conteúdo (aceita HTML)
    <textarea name="conteudo" rows="12" required><%= post ? post.conteudo : '' %></textarea>
  </label>
  <label>Categoria
    <select name="categoriaId">
      <option value="">Sem categoria</option>
      <% categorias.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= post && post.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
      <% }) %>
    </select>
  </label>
  <label>Imagem destacada
    <input type="file" name="imagem" accept="image/*">
  </label>
  <% if (post && post.imagem) { %>
    <p class="dica">Imagem atual: <a href="<%= post.imagem %>" target="_blank"><%= post.imagem %></a></p>
  <% } %>
  <% if (usuarioLogado.papel !== 'usuario') { %>
    <label>Status
      <select name="status">
        <option value="rascunho" <%= post && post.status === 'rascunho' ? 'selected' : '' %>>Rascunho</option>
        <option value="publicado" <%= post && post.status === 'publicado' ? 'selected' : '' %>>Publicado</option>
      </select>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="destaque" <%= post && post.destaque ? 'checked' : '' %>> Destaque na página inicial
    </label>
  <% } else { %>
    <p class="dica">Seu post será salvo como rascunho e revisado por um gestor ou administrador.</p>
  <% } %>
  <div class="form-acoes">
    <button class="btn btn-primario">Salvar</button>
    <a href="/admin/posts" class="btn btn-sec">Cancelar</a>
  </div>
</form>
