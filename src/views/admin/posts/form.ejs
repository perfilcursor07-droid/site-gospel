          palavrasChave: document.getElementById('ia-palavras').value
        }, opcoesBuscaIa()));
        preencherFormulario(data.artigo);
        if (data.avisoImagem) mostrarStatus(data.avisoImagem + ' Use "Buscar imagem na web" na barra lateral.', 'aviso');
        if (data.avisoQualidade) mostrarStatus(data.avisoQualidade, 'aviso');
      }
    } catch (e) { mostrarStatus(e.message, 'erro'); }
    finally { setCarregando(btnUma, false, 'Gerar 1 para revisar'); }
  });

  btnLote.addEventListener('click', async function () {
    var sel = topicosSelecionados();
    if (!sel.length) { mostrarStatus('Selecione ao menos um tópico.', 'erro'); return; }
    var modoIntervalo = document.querySelector('input[name="ia-modo-pub"]:checked')?.value === 'intervalos';
    var msgConfirm = modoIntervalo
      ? 'Agendar ' + sel.length + ' matéria(s) em intervalos no servidor? Você poderá fechar esta página.'
      : 'Gerar ' + sel.length + ' matéria(s) de uma vez? Pode levar alguns minutos.';
    if (!confirm(msgConfirm)) return;
    setCarregando(btnLote, true);
    try {
      if (modoIntervalo) {
        await agendarTopicosNaFila(sel);
      } else {
        await publicarTopicos(sel);
      }
    } catch (e) {
      mostrarStatus(e.message, 'erro');
    } finally {
      setCarregando(btnLote, false, 'Gerar matérias');
    }
  });

  selecionarTodos.addEventListener('change', function () {
    document.querySelectorAll('.ia-topico-check:not(:disabled)').forEach(function (cb) {
      cb.checked = selecionarTodos.checked;
    });
  });

  listaTopicos.addEventListener('change', function (e) {
    if (e.target.classList.contains('ia-topico-check')) atualizarSelecionarTodos();
  });

  var paramsAuto = new URLSearchParams(window.location.search);
  if (paramsAuto.get('auto') === '1' || paramsAuto.get('monitor') === '1') {
    if (modoTabs[1]) modoTabs[1].click();
    var radioAuto = document.querySelector('input[name="ia-modo-busca"][value="auto"]');
    if (radioAuto) {
      radioAuto.checked = true;
      atualizarModoBusca();
    }
  }
  <% } %>
})();
</script>
