<% const ehNovo = !post; const podeIa = ehNovo && usuarioLogado.papel !== 'usuario'; %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<div class="post-editor">
  <header class="post-editor-header">
    <div class="post-editor-titulo">
      <a href="/admin/posts" class="voltar-posts">← Posts</a>
      <h1><%= post ? 'Editar post' : 'Novo post' %></h1>
    </div>
    <% if (podeIa) { %>
    <div class="modo-tabs" role="tablist">
      <button type="button" class="modo-tab ativa" data-modo="manual" role="tab">Escrever</button>
      <button type="button" class="modo-tab" data-modo="ia" role="tab">Gerar com IA</button>
    </div>
    <% } %>
  </header>

  <% if (podeIa) { %>
  <section class="painel-ia modo-painel" id="painel-ia" hidden>
    <div class="painel-ia-intro">
      <div>
        <h2>Gerar matérias com IA</h2>
        <p class="dica">Matérias originais com furo de reportagem (550–850 palavras), padrão Google E-E-A-T. Reescreve fontes — não plágia. Revise antes de publicar.</p>
      </div>
      <span class="badge-ia">DeepSeek</span>
    </div>

    <div class="ia-modo-busca" role="tablist" aria-label="Modo de busca">
      <label class="ia-modo-busca-opcao">
        <input type="radio" name="ia-modo-busca" value="manual" checked>
        <span><strong>Buscar e escolher</strong><small>Você pesquisa, marca os assuntos e gera manualmente.</small></span>
      </label>
      <label class="ia-modo-busca-opcao ia-modo-busca-opcao--destaque">
        <input type="radio" name="ia-modo-busca" value="auto">
        <span><strong>Automação contínua</strong><small>Só digite o assunto — o servidor busca e publica sozinho.</small></span>
      </label>
    </div>

    <div id="ia-fluxo-manual">
    <div class="ia-passos" role="tablist" aria-label="Etapas">
      <div class="ia-passo ativo" data-passo="1"><span>1</span> Buscar</div>
      <div class="ia-passo" data-passo="2"><span>2</span> Escolher</div>
      <div class="ia-passo" data-passo="3"><span>3</span> Gerar</div>
    </div>

    <div class="ia-passo-conteudo" id="ia-passo-1">
      <div class="ia-bloco">
        <label for="ia-palavras" class="ia-bloco-titulo">O que buscar?</label>
        <input type="text" id="ia-palavras" class="ia-input-grande" placeholder="Ex: gospel, pastor, louvor, testemunho" value="gospel, pastor, pastora, louvor">
        <div class="tags-rapidas">
          <% ['gospel', 'pastor', 'pastora', 'louvor', 'adoração', 'congresso', 'testemunho'].forEach(function (tag) { %>
            <button type="button" class="tag-rapida" data-tag="<%= tag %>"><%= tag %></button>
          <% }) %>
        </div>
      </div>

      <div class="ia-bloco ia-bloco-fontes">
        <span class="ia-bloco-titulo">Onde buscar assuntos</span>
        <div class="ia-fontes-grid">
          <label class="ia-fonte-card">
            <input type="radio" name="ia-fonte-busca" value="todas" checked>
            <span class="ia-fonte-card-titulo">Notícias + portais + redes</span>
            <span class="ia-fonte-card-desc">Google News, 18+ portais gospel, Brave, Trends, Instagram, Facebook, X, TikTok, YouTube e mais</span>
          </label>
          <label class="ia-fonte-card ia-fonte-card--destaque">
            <input type="radio" name="ia-fonte-busca" value="somente_redes">
            <span class="ia-fonte-card-titulo">Somente redes sociais</span>
            <span class="ia-fonte-card-desc">Instagram, Facebook, X, Threads, TikTok, YouTube, LinkedIn e mais</span>
          </label>
        </div>
      </div>

      <div class="ia-opcoes-linha ia-opcoes-busca">
        <div class="ia-campo ia-campo-compacto">
          <label for="ia-quantidade">Por nicho</label>
          <select id="ia-quantidade">
            <option value="3">3</option>
            <option value="5" selected>5</option>
            <option value="8">8</option>
            <option value="10">10</option>
          </select>
        </div>
        <div class="ia-campo ia-campo-compacto">
          <label for="ia-dias">Período</label>
          <select id="ia-dias">
            <option value="24h" selected>Últimas 24 horas</option>
            <option value="3">3 dias</option>
            <option value="5">5 dias</option>
            <option value="7">7 dias</option>
          </select>
        </div>
        <label class="checkbox ia-check-compacto" id="label-ia-somente-recentes">
          <input type="checkbox" id="ia-somente-recentes" checked> Filtrar por período
        </label>
        <label class="checkbox ia-check-compacto" id="label-ia-redes-sociais">
          <input type="checkbox" id="ia-redes-sociais" checked> Incluir redes (modo misto)
        </label>
        <label class="checkbox ia-check-compacto" id="label-ia-google-trends">
          <input type="checkbox" id="ia-google-trends" checked> Google Trends
        </label>
        <label class="checkbox ia-check-compacto ia-check-internacional" id="label-ia-internacional">
          <input type="checkbox" id="ia-conteudo-internacional"> Conteúdo internacional
        </label>
        <p class="dica ia-dica-internacional" id="dica-ia-internacional" hidden>
          Busca em inglês/espanhol (Christian Post, Google News US, etc.). O DeepSeek traduz e reescreve em português com furo de reportagem — sem plágio.
        </p>
      </div>

      <div class="ia-passo-acoes ia-passo-acoes-inicio">
        <button type="button" class="btn btn-primario btn-ia-principal" id="btn-ia-pesquisar">Buscar assuntos</button>
      </div>
    </div>

    <div class="ia-passo-conteudo" id="ia-passo-2" hidden>
      <div class="ia-passo-topo">
        <div>
          <h3>Assuntos encontrados</h3>
          <p class="dica ia-dica-topo">Marque os que deseja gerar. Itens <strong>Já publicado</strong> estão bloqueados.</p>
        </div>
        <label class="checkbox ia-selecionar-todos">
          <input type="checkbox" id="ia-selecionar-todos" checked> Todos
        </label>
      </div>
      <div id="ia-lista-topicos" class="ia-lista-topicos"></div>
      <div class="ia-passo-acoes">
        <button type="button" class="btn btn-sec" id="btn-ia-voltar-1">← Buscar de novo</button>
        <button type="button" class="btn btn-sec" id="btn-ia-uma">Gerar 1 para revisar</button>
        <button type="button" class="btn btn-primario" id="btn-ia-continuar-2">Continuar →</button>
      </div>
    </div>

    <div class="ia-passo-conteudo" id="ia-passo-3" hidden>
      <div class="ia-pub-resumo" id="ia-resumo-selecao">Nenhuma matéria selecionada.</div>

      <div class="ia-pub-grid">
        <div class="ia-pub-card">
          <h4 class="ia-pub-card-titulo">Antes de gerar</h4>
          <div class="ia-campo">
            <label for="ia-categoria">Categoria</label>
            <select id="ia-categoria">
              <option value="">Sem categoria</option>
              <% categorias.forEach(function (c) { %>
                <option value="<%= c.id %>"><%= c.nome %></option>
              <% }) %>
            </select>
          </div>
          <div class="ia-campo">
            <label for="ia-status">Salvar como</label>
            <select id="ia-status">
              <option value="rascunho">Rascunho</option>
              <option value="publicado" selected>Publicado</option>
            </select>
            <p class="dica ia-dica-status">Sem capa → vira rascunho automaticamente.</p>
          </div>
        </div>

        <div class="ia-pub-card">
          <h4 class="ia-pub-card-titulo">Modo de geração</h4>
          <div class="ia-modo-opcoes ia-modo-opcoes-compacto">
            <label class="ia-modo-opcao">
              <input type="radio" name="ia-modo-pub" value="todos" checked>
              <span>
                <strong>Tudo de uma vez</strong>
                <small>Gera todas em sequência.</small>
              </span>
            </label>
            <label class="ia-modo-opcao">
              <input type="radio" name="ia-modo-pub" value="intervalos">
              <span>
                <strong>Em intervalos</strong>
                <small>Agenda no servidor — pode fechar a página.</small>
              </span>
            </label>
          </div>

          <div class="ia-intervalo-config" id="ia-intervalo-config" hidden>
            <div class="ia-opcoes-linha ia-opcoes-linha-intervalo">
              <div class="ia-campo ia-campo-compacto">
                <label for="ia-qtd-intervalo">Por lote</label>
                <select id="ia-qtd-intervalo">
                  <option value="1" selected>1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                  <option value="5">5</option>
                </select>
              </div>
              <div class="ia-campo ia-campo-compacto">
                <label for="ia-min-intervalo">Pausa</label>
                <select id="ia-min-intervalo">
                  <option value="5">5 min</option>
                  <option value="15" selected>15 min</option>
                  <option value="30">30 min</option>
                  <option value="60">1 h</option>
                  <option value="120">2 h</option>
                </select>
              </div>
              <div class="ia-campo ia-campo-compacto">
                <label for="ia-inicio-modo">Início</label>
                <select id="ia-inicio-modo">
                  <option value="agora">Agora</option>
                  <option value="apos_fila">Após a fila atual</option>
                  <option value="custom">Data e hora</option>
                </select>
              </div>
            </div>
            <div class="ia-opcoes-linha ia-opcoes-linha-intervalo ia-inicio-custom-linha" id="ia-inicio-custom-linha" hidden>
              <div class="ia-campo">
                <label for="ia-inicio-custom">Data e hora de início</label>
                <input type="datetime-local" id="ia-inicio-custom" class="ia-input-datetime">
              </div>
            </div>
            <p class="dica ia-inicio-dica" id="ia-inicio-dica" hidden></p>
          </div>
          <p class="dica ia-plano-publicacao" id="ia-plano-publicacao"></p>
        </div>
      </div>

      <div class="ia-progresso" id="ia-progresso" hidden>
        <div class="ia-progresso-barra"><span id="ia-progresso-fill"></span></div>
        <p class="ia-progresso-texto" id="ia-progresso-texto"></p>
      </div>

      <div class="ia-passo-acoes ia-passo-acoes-publicar">
        <button type="button" class="btn btn-sec" id="btn-ia-voltar-2">← Voltar</button>
        <button type="button" class="btn btn-primario btn-ia-principal" id="btn-ia-lote">Gerar matérias</button>
        <button type="button" class="btn btn-perigo btn-link" id="btn-ia-cancelar" hidden>Cancelar</button>
      </div>
    </div>
    </div><!-- /ia-fluxo-manual -->

    <div id="ia-fluxo-auto" hidden>
      <div class="ia-auto-banner">
        <div class="ia-auto-banner-icone" aria-hidden="true">⚡</div>
        <div>
          <strong>Não precisa buscar agora.</strong>
          <p>Digite o assunto abaixo, configure os intervalos e clique <em>Iniciar automação</em>. O servidor busca fontes recentes, gera matérias com furo de reportagem e publica sozinho — pode fechar esta página.</p>
        </div>
      </div>

      <div class="ia-bloco">
        <label for="ia-auto-palavras" class="ia-bloco-titulo">O que monitorar?</label>
        <input type="text" id="ia-auto-palavras" class="ia-input-grande" placeholder="Ex: polêmica gospel, pastor, louvor, congresso gospel">
        <p class="dica">Uma ou mais palavras separadas por vírgula. Só assuntos <strong>recentes</strong> e ainda não publicados no site.</p>
        <div class="tags-rapidas tags-rapidas-auto">
          <% ['polêmica gospel', 'pastor', 'louvor', 'adoração', 'congresso', 'testemunho'].forEach(function (tag) { %>
            <button type="button" class="tag-rapida tag-rapida-auto" data-tag="<%= tag %>"><%= tag %></button>
          <% }) %>
        </div>
      </div>

      <div class="ia-bloco ia-bloco-fontes">
        <span class="ia-bloco-titulo">Onde buscar (busca ampliada automática)</span>
        <div class="ia-fontes-grid">
          <label class="ia-fonte-card">
            <input type="radio" name="ia-fonte-busca-auto" value="todas" checked>
            <span class="ia-fonte-card-titulo">Tudo: notícias + portais + redes</span>
            <span class="ia-fonte-card-desc">18+ portais gospel, Google News, Brave, Trends, Instagram, Facebook, X, Threads, TikTok, YouTube, LinkedIn e web</span>
          </label>
          <label class="ia-fonte-card ia-fonte-card--destaque">
            <input type="radio" name="ia-fonte-busca-auto" value="somente_redes">
            <span class="ia-fonte-card-titulo">Foco em redes sociais</span>
            <span class="ia-fonte-card-desc">Polêmicas e assuntos em alta nas redes — ideal para furo rápido</span>
          </label>
        </div>
        <div class="ia-opcoes-linha ia-opcoes-busca">
          <div class="ia-campo ia-campo-compacto">
            <label for="ia-auto-dias">Período</label>
            <select id="ia-auto-dias">
              <option value="24h" selected>Últimas 24 horas</option>
              <option value="3">3 dias</option>
              <option value="5">5 dias</option>
            </select>
          </div>
          <label class="checkbox ia-check-compacto">
            <input type="checkbox" id="ia-auto-google-trends" checked> Google Trends
          </label>
          <label class="checkbox ia-check-compacto">
            <input type="checkbox" id="ia-auto-internacional"> Conteúdo internacional
          </label>
        </div>
      </div>

      <div class="ia-pub-grid ia-auto-grid">
        <div class="ia-pub-card">
          <h4 class="ia-pub-card-titulo">Publicação</h4>
          <div class="ia-campo">
            <label for="ia-auto-categoria">Categoria</label>
            <select id="ia-auto-categoria">
              <option value="">Sem categoria</option>
              <% categorias.forEach(function (c) { %>
                <option value="<%= c.id %>"><%= c.nome %></option>
              <% }) %>
            </select>
          </div>
          <div class="ia-campo">
            <label for="ia-auto-status">Salvar como</label>
            <select id="ia-auto-status">
              <option value="rascunho">Rascunho</option>
              <option value="publicado" selected>Publicado</option>
            </select>
            <p class="dica ia-dica-status">Sem capa → vira rascunho automaticamente.</p>
          </div>
        </div>

        <div class="ia-pub-card">
          <h4 class="ia-pub-card-titulo">Intervalos</h4>
          <div class="ia-opcoes-linha ia-opcoes-linha-intervalo">
            <div class="ia-campo ia-campo-compacto">
              <label for="ia-auto-qtd">Por ciclo</label>
              <select id="ia-auto-qtd">
                <option value="1" selected>1 matéria</option>
                <option value="2">2 matérias</option>
                <option value="3">3 matérias</option>
                <option value="5">5 matérias</option>
              </select>
            </div>
            <div class="ia-campo ia-campo-compacto">
              <label for="ia-auto-intervalo">A cada</label>
              <select id="ia-auto-intervalo">
                <option value="15">15 min</option>
                <option value="30" selected>30 min</option>
                <option value="60">1 h</option>
                <option value="120">2 h</option>
                <option value="240">4 h</option>
                <option value="360">6 h</option>
              </select>
            </div>
          </div>
          <div class="ia-opcoes-linha ia-opcoes-linha-intervalo">
            <div class="ia-campo">
              <label for="ia-auto-inicio">Início</label>
              <input type="datetime-local" id="ia-auto-inicio" class="ia-input-datetime">
            </div>
            <div class="ia-campo">
              <label for="ia-auto-fim">Fim (opcional)</label>
              <input type="datetime-local" id="ia-auto-fim" class="ia-input-datetime">
            </div>
          </div>
          <p class="dica ia-plano-publicacao" id="ia-auto-plano"></p>
        </div>
      </div>

      <div class="ia-passo-acoes ia-passo-acoes-inicio">
        <button type="button" class="btn btn-primario btn-ia-principal btn-ia-auto-grande" id="btn-ia-auto-iniciar">Iniciar automação</button>
      </div>

      <div class="ia-auto-lista-wrap" id="ia-auto-lista-wrap" hidden>
        <h4 class="ia-pub-card-titulo">Automações ativas</h4>
        <div id="ia-auto-lista" class="ia-auto-lista"></div>
      </div>
    </div>

    <div id="ia-status-msg" class="ia-status-msg" hidden></div>
  </section>
  <% } %>

  <form action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>" method="post" enctype="multipart/form-data" class="post-editor-form modo-painel ativa" id="form-post">
    <div class="post-editor-corpo">
      <div class="post-editor-main">
        <section class="editor-bloco">
          <label class="editor-label" for="campo-titulo">Título da matéria</label>
          <input type="text" name="titulo" id="campo-titulo" class="input-titulo" value="<%= post ? post.titulo : '' %>" placeholder="Digite um título chamativo..." required>
        </section>

        <section class="editor-bloco">
          <label class="editor-label" for="campo-resumo">Subtítulo / linha fina</label>
          <textarea name="resumo" id="campo-resumo" rows="2" class="input-resumo" placeholder="Resumo curto que aparece na listagem e abaixo do título"><%= post ? (post.resumo || '') : '' %></textarea>
          <p class="dica contador-linha"><span id="cont-resumo">0</span>/200 caracteres</p>
        </section>

        <section class="editor-bloco editor-bloco-conteudo">
          <div class="editor-conteudo-header">
            <label class="editor-label" for="quill-editor">Conteúdo da matéria</label>
            <div class="editor-modo-tabs" role="tablist">
              <button type="button" class="editor-modo-btn ativa" data-editor-modo="visual" role="tab">Visual</button>
              <button type="button" class="editor-modo-btn" data-editor-modo="html" role="tab">HTML</button>
            </div>
          </div>
          <div class="editor-visual-wrap" id="editor-visual-wrap">
            <div id="quill-editor"></div>
          </div>
          <textarea name="conteudo" id="campo-conteudo" class="editor-html-textarea" hidden><%= post ? post.conteudo : '' %></textarea>
        </section>

        <section class="editor-bloco editor-bloco-seo" id="bloco-seo">
          <button type="button" class="seo-toggle" id="seo-toggle" aria-expanded="false">
            <span>SEO avançado</span>
            <span class="seo-toggle-icone">▼</span>
          </button>
          <div class="seo-conteudo" id="seo-conteudo" hidden>
            <label class="editor-label-sm" for="meta-title">Meta título <span class="contador-inline" id="cont-meta-titulo">0</span>/60</label>
            <input type="text" name="meta_title" id="meta-title" maxlength="60" value="<%= post ? (post.metaTitle || '') : '' %>" data-contador="cont-meta-titulo" placeholder="Título para o Google (opcional)">
            <label class="editor-label-sm" for="meta-desc">Meta descrição <span class="contador-inline" id="cont-meta-desc">0</span>/160</label>
            <textarea name="meta_description" id="meta-desc" rows="2" maxlength="160" data-contador="cont-meta-desc" placeholder="Descrição para resultados de busca (opcional)"><%= post ? (post.metaDescription || '') : '' %></textarea>
            <div class="snippet-google" id="snippet-preview">
              <div class="snippet-url"><%= config.site_nome || 'Site Gospel' %> › post › <span id="slug-previa"><%= post ? post.slug : '...' %></span></div>
              <div class="snippet-titulo" id="snippet-titulo"><%= post ? post.titulo : 'Título da matéria' %></div>
              <div class="snippet-desc" id="snippet-desc"><%= post ? (post.resumo || 'Descrição da matéria...') : 'Descrição da matéria...' %></div>
            </div>
          </div>
        </section>
      </div>

      <aside class="post-editor-sidebar">
        <div class="sidebar-card sidebar-publicar">
          <h3 class="sidebar-card-titulo">Publicação</h3>
          <% if (usuarioLogado.papel !== 'usuario') { %>
            <label class="sidebar-label">Status</label>
            <select name="status" class="sidebar-select">
              <option value="rascunho" <%= post && post.status === 'rascunho' ? 'selected' : (!post ? 'selected' : '') %>>Rascunho</option>
              <option value="publicado" <%= post && post.status === 'publicado' ? 'selected' : '' %>>Publicado</option>
            </select>
            <% if (post) { %>
            <label class="checkbox sidebar-check">
              <input type="checkbox" name="destaque" <%= post.destaque ? 'checked' : '' %>>
              Destaque na home
            </label>
            <% } %>
          <% } else { %>
            <p class="dica sidebar-aviso">Salvo como rascunho para revisão.</p>
          <% } %>
          <div class="sidebar-botoes">
            <button type="submit" class="btn btn-primario btn-bloco" id="btn-salvar">
              <%= post ? 'Atualizar' : 'Publicar matéria' %>
            </button>
            <% if (post && post.status === 'publicado') { %>
              <a href="/post/<%= post.slug %>" target="_blank" class="btn btn-sec btn-bloco">Ver no site</a>
            <% } %>
            <a href="/admin/posts" class="btn btn-sec btn-bloco btn-ghost">Cancelar</a>
          </div>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-titulo">Categoria</h3>
          <select name="categoriaId" class="sidebar-select">
            <option value="">Sem categoria</option>
            <% categorias.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= post && post.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
            <% }) %>
          </select>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-titulo">Imagem de capa</h3>
          <div class="upload-zona<%= post && post.imagem ? ' has-preview' : '' %>" id="upload-zona">
            <img id="preview-imagem" src="<%= post && post.imagem ? post.imagem : '' %>" alt="Prévia" class="preview-img preview-cap" <%= post && post.imagem ? '' : 'hidden' %>>
            <div class="upload-placeholder" id="upload-placeholder" <%= post && post.imagem ? 'hidden' : '' %>>
              <span class="upload-icone">+</span>
              <span>Clique ou arraste uma imagem</span>
              <span class="dica">JPG, PNG ou WebP · máx. 5 MB · convertido para WebP</span>
            </div>
            <input type="file" name="imagem" id="campo-imagem" accept="image/*" class="upload-input">
          </div>
          <input type="hidden" name="imagem_ia_url" id="imagem-ia-url" value="">
          <label for="imagem-alt-ia" class="sidebar-label" style="margin-top: 12px;">Legenda da capa</label>
          <textarea name="imagem_alt" id="imagem-alt-ia" rows="2" maxlength="500" class="sidebar-textarea" placeholder="Descrição visível abaixo da foto (SEO e acessibilidade)"><%= post && post.imagemAlt ? post.imagemAlt : '' %></textarea>
          <p class="dica">Aparece abaixo da imagem na matéria e no atributo alt para buscadores.</p>
          <div class="capa-busca-acoes">
            <button type="button" class="btn btn-sec btn-bloco" id="btn-buscar-capa">Buscar imagem na web</button>
            <p class="dica capa-busca-dica">Usa Brave Search e DuckDuckGo — escolha uma foto e vincule como capa sem baixar manualmente.</p>
          </div>
          <div class="capa-sem-imagem" id="aviso-sem-capa" <%= post && !post.imagem ? '' : 'hidden' %>>
            <strong>Sem capa.</strong> Use o botão acima para buscar uma imagem ou faça upload.
          </div>
        </div>

        <div class="modal-capa" id="modal-buscar-capa" hidden aria-hidden="true">
          <div class="modal-capa-backdrop" id="modal-capa-fechar"></div>
          <div class="modal-capa-painel" role="dialog" aria-labelledby="modal-capa-titulo" aria-modal="true">
            <header class="modal-capa-header">
              <h3 id="modal-capa-titulo">Buscar imagem de capa</h3>
              <button type="button" class="modal-capa-x" id="modal-capa-x" aria-label="Fechar">×</button>
            </header>
            <div class="modal-capa-busca">
              <input type="text" id="capa-termos-busca" class="ia-input-grande" placeholder="Termos de busca (padrão: título da matéria)">
              <button type="button" class="btn btn-prim" id="btn-executar-busca-capa">Buscar</button>
            </div>
            <p class="modal-capa-status" id="modal-capa-status"></p>
            <div class="modal-capa-grid" id="modal-capa-grid"></div>
          </div>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-titulo">URL do post</h3>
          <div class="slug-box">
            <span class="slug-prefix">/post/</span>
            <input type="text" name="slug" id="campo-slug" value="<%= post ? post.slug : '' %>" placeholder="auto" class="slug-input">
          </div>
          <p class="dica">Gerado automaticamente pelo título.</p>
        </div>

        <div class="sidebar-card sidebar-checklist" id="checklist">
          <h3 class="sidebar-card-titulo">Checklist</h3>
          <ul class="checklist-itens">
            <li id="check-titulo" class="pendente">Título preenchido</li>
            <li id="check-conteudo" class="pendente">Conteúdo escrito</li>
            <li id="check-categoria" class="opcional">Categoria (opcional)</li>
            <li id="check-imagem" class="opcional">Imagem de capa (opcional)</li>
          </ul>
        </div>
      </aside>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
(function () {
  var titulo = document.getElementById('campo-titulo');
  var slug = document.getElementById('campo-slug');
  var resumo = document.getElementById('campo-resumo');
  var conteudo = document.getElementById('campo-conteudo');
  var previa = document.getElementById('slug-previa');
  var slugEditado = slug && slug.value !== '';
  var quill = null;
  var formPost = document.getElementById('form-post');

  function sincronizarConteudo() {
    if (quill && conteudo) conteudo.value = quill.root.innerHTML;
  }

  function definirConteudoEditor(html) {
    if (!conteudo) return;
    conteudo.value = html || '';
    if (quill) {
      quill.setText('');
      if (html && html.trim()) quill.clipboard.dangerouslyPasteHTML(html);
    }
    atualizarChecklist();
  }

  if (typeof Quill !== 'undefined' && document.getElementById('quill-editor')) {
    quill = new Quill('#quill-editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [2, 3, false] }],
          ['bold', 'italic', 'underline'],
          ['blockquote'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link'],
          ['clean']
        ]
      },
      placeholder: 'Escreva o texto completo da matéria...'
    });
    if (conteudo.value.trim()) quill.clipboard.dangerouslyPasteHTML(conteudo.value);
    quill.on('text-change', function () { sincronizarConteudo(); atualizarChecklist(); });

    var modoBtns = document.querySelectorAll('.editor-modo-btn');
    var visualWrap = document.getElementById('editor-visual-wrap');
    modoBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var modo = btn.dataset.editorModo;
        modoBtns.forEach(function (b) { b.classList.toggle('ativa', b === btn); });
        if (modo === 'html') {
          sincronizarConteudo();
          if (visualWrap) visualWrap.hidden = true;
          conteudo.hidden = false;
        } else {
          definirConteudoEditor(conteudo.value);
          if (visualWrap) visualWrap.hidden = false;
          conteudo.hidden = true;
        }
      });
    });
  }

  if (formPost) {
    formPost.addEventListener('submit', function (e) {
      sincronizarConteudo();
      var texto = conteudo.value.replace(/<[^>]+>/g, '').trim();
      if (!texto) {
        e.preventDefault();
        alert('Preencha o conteúdo da matéria.');
        document.querySelector('[data-editor-modo="visual"]')?.click();
      }
    });
  }

  window.definirConteudoEditor = definirConteudoEditor;

  function gerarSlug(t) {
    return t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  function atualizarPrevia() {
    if (previa) previa.textContent = (slug && slug.value) || gerarSlug(titulo.value) || '...';
    var st = document.getElementById('snippet-titulo');
    var sd = document.getElementById('snippet-desc');
    if (st) st.textContent = document.getElementById('meta-title')?.value || titulo.value || 'Título da matéria';
    if (sd) sd.textContent = document.getElementById('meta-desc')?.value || resumo.value || 'Descrição da matéria...';
    atualizarChecklist();
  }

  if (titulo) {
    titulo.addEventListener('input', function () {
      if (!slugEditado && slug) slug.value = gerarSlug(titulo.value);
      atualizarPrevia();
    });
  }
  if (slug) slug.addEventListener('input', function () { slugEditado = slug.value !== ''; atualizarPrevia(); });
  if (resumo) resumo.addEventListener('input', function () {
    var c = document.getElementById('cont-resumo');
    if (c) c.textContent = resumo.value.length;
    atualizarPrevia();
  });
  if (conteudo) conteudo.addEventListener('input', atualizarChecklist);

  document.querySelectorAll('[data-contador]').forEach(function (campo) {
    var contador = document.getElementById(campo.dataset.contador);
    function atualizar() {
      if (contador) contador.textContent = campo.value.length;
      atualizarPrevia();
    }
    campo.addEventListener('input', atualizar);
    atualizar();
  });
  if (resumo) {
    var cr = document.getElementById('cont-resumo');
    if (cr) cr.textContent = resumo.value.length;
  }

  function atualizarChecklist() {
    var ct = document.getElementById('check-titulo');
    var cc = document.getElementById('check-conteudo');
    var ccat = document.getElementById('check-categoria');
    var cimg = document.getElementById('check-imagem');
    if (ct) ct.className = titulo.value.trim() ? 'ok' : 'pendente';
    if (cc) {
      var html = conteudo ? conteudo.value : '';
      var texto = html.replace(/<[^>]+>/g, '').trim();
      cc.className = texto ? 'ok' : 'pendente';
    }
    var cat = document.querySelector('[name="categoriaId"]');
    if (ccat) ccat.className = cat && cat.value ? 'ok' : 'opcional';
    var img = document.getElementById('preview-imagem');
    if (cimg) cimg.className = (img && !img.hidden) ? 'ok' : 'opcional';
  }
  atualizarChecklist();
  document.querySelector('[name="categoriaId"]')?.addEventListener('change', atualizarChecklist);

  var seoToggle = document.getElementById('seo-toggle');
  var seoConteudo = document.getElementById('seo-conteudo');
  if (seoToggle && seoConteudo) {
    seoToggle.addEventListener('click', function () {
      var aberto = seoConteudo.hidden;
      seoConteudo.hidden = !aberto;
      seoToggle.setAttribute('aria-expanded', aberto);
      seoToggle.querySelector('.seo-toggle-icone').textContent = aberto ? '▲' : '▼';
    });
  }

  var inputImagem = document.getElementById('campo-imagem');
  var previewImagem = document.getElementById('preview-imagem');
  var uploadPlaceholder = document.getElementById('upload-placeholder');
  var uploadZona = document.getElementById('upload-zona');

  function mostrarImagem(src) {
    previewImagem.src = src;
    previewImagem.hidden = false;
    if (uploadPlaceholder) uploadPlaceholder.hidden = true;
    if (uploadZona) uploadZona.classList.add('has-preview');
    var avisoSem = document.getElementById('aviso-sem-capa');
    if (avisoSem) avisoSem.hidden = true;
    atualizarChecklist();
  }

  (function initBuscaCapa() {
    var modal = document.getElementById('modal-buscar-capa');
    var btnAbrir = document.getElementById('btn-buscar-capa');
    var btnFechar = document.getElementById('modal-capa-x');
    var backdrop = document.getElementById('modal-capa-fechar');
    var btnBuscar = document.getElementById('btn-executar-busca-capa');
    var campoTermos = document.getElementById('capa-termos-busca');
    var grid = document.getElementById('modal-capa-grid');
    var statusModal = document.getElementById('modal-capa-status');
    var campoIaUrl = document.getElementById('imagem-ia-url');
    var campoAlt = document.getElementById('imagem-alt-ia');

    if (!modal || !btnAbrir) return;

    function fecharModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-capa-aberto');
    }

    function abrirModal() {
      if (campoTermos && titulo && !campoTermos.value.trim()) {
        campoTermos.value = titulo.value.trim();
      }
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-capa-aberto');
      if (campoTermos) campoTermos.focus();
    }

    function textoPlanoHtml(html) {
      return (html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function escaparHtml(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function setStatusModal(msg, tipo) {
      if (!statusModal) return;
      statusModal.textContent = msg || '';
      statusModal.className = 'modal-capa-status' + (tipo ? ' is-' + tipo : '');
    }

    async function buscarImagensCapa() {
      var termos = campoTermos ? campoTermos.value.trim() : '';
      if (!termos && titulo) termos = titulo.value.trim();
      if (!termos) {
        setStatusModal('Informe termos de busca ou preencha o título da matéria.', 'erro');
        return;
      }
      setStatusModal('Buscando imagens…', 'info');
      if (grid) grid.innerHTML = '';
      btnBuscar.disabled = true;
      try {
        var res = await fetch('/admin/posts/buscar-imagens', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            titulo: titulo ? titulo.value.trim() : '',
            resumo: resumo ? resumo.value.trim() : '',
            termos: termos,
            assuntoImagem: campoAlt ? campoAlt.value.trim() : ''
          })
        });
        var data = await res.json();
        if (!data.ok) throw new Error(data.erro || 'Erro na busca.');
        if (!data.candidatos || !data.candidatos.length) {
          setStatusModal(data.mensagem || 'Nenhuma imagem encontrada. Tente outros termos.', 'aviso');
          return;
        }
        setStatusModal(data.mensagem, 'sucesso');
        data.candidatos.forEach(function (c) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'modal-capa-item';
          btn.title = c.title || 'Usar como capa';
          btn.innerHTML =
            '<img src="' + escaparHtml(c.preview || c.url) + '" alt="" loading="lazy" referrerpolicy="no-referrer">' +
            (c.title ? '<span class="modal-capa-item-titulo">' + escaparHtml(c.title) + '</span>' : '');
          btn.addEventListener('click', function () { vincularImagemCapa(c, btn); });
          grid.appendChild(btn);
        });
      } catch (e) {
        setStatusModal(e.message, 'erro');
      } finally {
        btnBuscar.disabled = false;
      }
    }

    async function vincularImagemCapa(candidato, btn) {
      if (btn) {
        btn.disabled = true;
        btn.classList.add('carregando');
      }
      setStatusModal('Baixando e vinculando imagem…', 'info');
      try {
        var res = await fetch('/admin/posts/vincular-imagem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            url: candidato.url,
            preview: candidato.preview || candidato.url,
            source: candidato.source || '',
            titulo: titulo ? titulo.value.trim() : '',
            resumo: resumo ? resumo.value.trim() : '',
            assuntoImagem: campoAlt ? campoAlt.value.trim() : '',
            alt: candidato.title || ''
          })
        });
        var data = await res.json();
        if (!data.ok) throw new Error(data.erro || 'Não foi possível vincular a imagem.');
        mostrarImagem(data.imagem);
        if (campoIaUrl) campoIaUrl.value = data.imagem;
        if (campoAlt && data.alt && !campoAlt.value.trim()) campoAlt.value = data.alt;
        if (inputImagem) inputImagem.value = '';
        fecharModal();
      } catch (e) {
        setStatusModal(e.message, 'erro');
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('carregando');
        }
      }
    }

    btnAbrir.addEventListener('click', abrirModal);
    btnFechar.addEventListener('click', fecharModal);
    backdrop.addEventListener('click', fecharModal);
    btnBuscar.addEventListener('click', buscarImagensCapa);
    campoTermos.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); buscarImagensCapa(); }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) fecharModal();
    });
  })();

  if (inputImagem) {
    inputImagem.addEventListener('change', function () {
      if (inputImagem.files && inputImagem.files[0]) {
        mostrarImagem(URL.createObjectURL(inputImagem.files[0]));
      }
    });
  }
  if (uploadZona) {
    uploadZona.addEventListener('dragover', function (e) { e.preventDefault(); uploadZona.classList.add('drag-over'); });
    uploadZona.addEventListener('dragleave', function () { uploadZona.classList.remove('drag-over'); });
    uploadZona.addEventListener('drop', function (e) {
      e.preventDefault();
      uploadZona.classList.remove('drag-over');
      if (e.dataTransfer.files.length) {
        inputImagem.files = e.dataTransfer.files;
        mostrarImagem(URL.createObjectURL(e.dataTransfer.files[0]));
      }
    });
  }

  var statusSelect = document.querySelector('[name="status"]');
  var btnSalvar = document.getElementById('btn-salvar');
  var ehEdicao = <%= post ? 'true' : 'false' %>;
  if (statusSelect && btnSalvar) {
    function atualizarBotao() {
      if (statusSelect.value === 'publicado') {
        btnSalvar.textContent = ehEdicao ? 'Atualizar' : 'Publicar matéria';
      } else {
        btnSalvar.textContent = ehEdicao ? 'Salvar rascunho' : 'Salvar rascunho';
      }
    }
    statusSelect.addEventListener('change', atualizarBotao);
    atualizarBotao();
  }

  <% if (podeIa) { %>
  var modoTabs = document.querySelectorAll('.modo-tab');
  var painelIa = document.getElementById('painel-ia');

  modoTabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var modo = tab.dataset.modo;
      modoTabs.forEach(function (t) { t.classList.toggle('ativa', t === tab); });
      painelIa.hidden = modo !== 'ia';
      formPost.classList.toggle('ativa', modo === 'manual');
      formPost.hidden = modo !== 'manual';
    });
  });

  document.querySelectorAll('.tag-rapida').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = document.getElementById('ia-palavras');
      var tags = input.value.split(/[,;]/).map(function (t) { return t.trim(); }).filter(Boolean);
      if (tags.indexOf(btn.dataset.tag) === -1) tags.push(btn.dataset.tag);
      input.value = tags.join(', ');
    });
  });

  function irPasso(n) {
    document.querySelectorAll('.ia-passo').forEach(function (p) {
      p.classList.toggle('ativo', parseInt(p.dataset.passo, 10) === n);
      p.classList.toggle('concluido', parseInt(p.dataset.passo, 10) < n);
    });
    document.getElementById('ia-passo-1').hidden = n !== 1;
    document.getElementById('ia-passo-2').hidden = n !== 2;
    document.getElementById('ia-passo-3').hidden = n !== 3;
  }

  var topicosEncontrados = [];
  var btnPesquisar = document.getElementById('btn-ia-pesquisar');
  var btnUma = document.getElementById('btn-ia-uma');
  var btnLote = document.getElementById('btn-ia-lote');
  var statusMsg = document.getElementById('ia-status-msg');
  var listaTopicos = document.getElementById('ia-lista-topicos');
  var selecionarTodos = document.getElementById('ia-selecionar-todos');

  function mostrarStatus(texto, tipo) {
    statusMsg.hidden = false;
    statusMsg.className = 'ia-status-msg ia-status-' + (tipo || 'info');
    statusMsg.textContent = texto;
  }

  function setCarregando(btn, ativo, texto) {
    if (!btn) return;
    btn.disabled = ativo;
    btn.dataset.orig = btn.dataset.orig || btn.textContent;
    btn.textContent = ativo ? 'Aguarde...' : (texto || btn.dataset.orig);
  }

  async function chamarApi(url, body) {
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body)
    });
    var text = await res.text();
    var data;
    try { data = JSON.parse(text); } catch (e) {
      throw new Error(res.ok ? 'Resposta inválida do servidor.' : 'Erro no servidor (código ' + res.status + '). Tente novamente.');
    }
    if (!data.ok) throw new Error(data.erro || 'Erro na requisição');
    return data;
  }

  function opcoesBuscaIa() {
    var somenteRedes = document.querySelector('input[name="ia-fonte-busca"]:checked')?.value === 'somente_redes';
    var chkTrends = document.getElementById('ia-google-trends');
    return {
      incluirRedesSociais: somenteRedes || document.getElementById('ia-redes-sociais').checked,
      somenteRedesSociais: somenteRedes,
      somenteRecentes: document.getElementById('ia-somente-recentes').checked,
      diasRecentes: document.getElementById('ia-dias').value,
      conteudoInternacional: document.getElementById('ia-conteudo-internacional').checked,
      incluirGoogleTrends: !somenteRedes && chkTrends && chkTrends.checked,
      buscaAmpliada: false
    };
  }

  function opcoesBuscaAuto() {
    var somenteRedes = document.querySelector('input[name="ia-fonte-busca-auto"]:checked')?.value === 'somente_redes';
    var chkTrends = document.getElementById('ia-auto-google-trends');
    return {
      incluirRedesSociais: !somenteRedes,
      somenteRedesSociais: somenteRedes,
      somenteRecentes: true,
      diasRecentes: document.getElementById('ia-auto-dias')?.value || '24h',
      conteudoInternacional: document.getElementById('ia-auto-internacional')?.checked || false,
      incluirGoogleTrends: !somenteRedes && chkTrends && chkTrends.checked,
      buscaAmpliada: true
    };
  }

  var slotFilaCache = null;

  async function carregarProximoSlotFila() {
    try {
      var min = document.getElementById('ia-min-intervalo')?.value || 5;
      var res = await fetch('/admin/posts/ia/fila-proximo-slot?minutos=' + encodeURIComponent(min), { headers: { Accept: 'application/json' } });
      var data = await res.json();
      if (data.ok) slotFilaCache = data;
      return data;
    } catch (e) {
      return null;
    }
  }

  function formatarDataHoraLocal(iso) {
    if (!iso) return '';
    return new Date(iso).toLocaleString('pt-BR', {
      day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
    });
  }

  function atualizarInicioIntervalo() {
    var modo = document.getElementById('ia-inicio-modo')?.value || 'agora';
    var linhaCustom = document.getElementById('ia-inicio-custom-linha');
    var inputCustom = document.getElementById('ia-inicio-custom');
    var dica = document.getElementById('ia-inicio-dica');
    if (linhaCustom) linhaCustom.hidden = modo !== 'custom';
    if (dica) {
      dica.hidden = modo === 'agora';
      if (modo === 'apos_fila' && slotFilaCache) {
        dica.textContent = slotFilaCache.temFilaAtiva
          ? 'Próximo slot sugerido: ' + formatarDataHoraLocal(slotFilaCache.sugeridoAposFila) + ' (após a última da fila ou agendada).'
          : 'Nenhuma fila ativa — começará em seguida, com o intervalo da primeira matéria.';
      } else if (modo === 'custom') {
        dica.textContent = 'A primeira matéria só será gerada a partir desta data/hora.';
      }
    }
    if (modo === 'custom' && inputCustom && !inputCustom.value) {
      var d = new Date(Date.now() + 60 * 60 * 1000);
      d.setMinutes(Math.ceil(d.getMinutes() / 5) * 5, 0, 0);
      inputCustom.value = d.toISOString().slice(0, 16);
    }
    atualizarPlanoPublicacao();
  }

  function atualizarOpcoesFonteBusca() {
    var somenteRedes = document.querySelector('input[name="ia-fonte-busca"]:checked')?.value === 'somente_redes';
    var labelRedes = document.getElementById('label-ia-redes-sociais');
    var chkRedes = document.getElementById('ia-redes-sociais');
    var labelTrends = document.getElementById('label-ia-google-trends');
    var dicaInt = document.getElementById('dica-ia-internacional');
    var chkInt = document.getElementById('ia-conteudo-internacional');
    if (labelRedes && chkRedes) {
      labelRedes.hidden = somenteRedes;
      if (somenteRedes) chkRedes.checked = true;
    }
    if (labelTrends) labelTrends.hidden = somenteRedes;
    if (dicaInt && chkInt) {
      dicaInt.hidden = !chkInt.checked;
    }
  }

  var chkInternacional = document.getElementById('ia-conteudo-internacional');
  if (chkInternacional) {
    chkInternacional.addEventListener('change', atualizarOpcoesFonteBusca);
  }

  document.querySelectorAll('input[name="ia-fonte-busca"]').forEach(function (radio) {
    radio.addEventListener('change', atualizarOpcoesFonteBusca);
  });
  atualizarOpcoesFonteBusca();

  var modoBuscaRadios = document.querySelectorAll('input[name="ia-modo-busca"]');
  var fluxoManual = document.getElementById('ia-fluxo-manual');
  var fluxoAuto = document.getElementById('ia-fluxo-auto');
  var autoInicio = document.getElementById('ia-auto-inicio');
  var autoFim = document.getElementById('ia-auto-fim');
  var autoPlano = document.getElementById('ia-auto-plano');
  var btnAutoIniciar = document.getElementById('btn-ia-auto-iniciar');
  var autoListaWrap = document.getElementById('ia-auto-lista-wrap');
  var autoLista = document.getElementById('ia-auto-lista');
  var autoPalavras = document.getElementById('ia-auto-palavras');

  function definirDatetimePadrao(input, offsetHoras) {
    if (!input || input.value) return;
    var d = new Date(Date.now() + (offsetHoras || 0) * 60 * 60 * 1000);
    d.setMinutes(Math.ceil(d.getMinutes() / 5) * 5, 0, 0);
    input.value = d.toISOString().slice(0, 16);
  }

  function modoBuscaAtual() {
    return document.querySelector('input[name="ia-modo-busca"]:checked')?.value || 'manual';
  }

  function atualizarModoBusca() {
    var auto = modoBuscaAtual() === 'auto';
    if (fluxoManual) fluxoManual.hidden = auto;
    if (fluxoAuto) fluxoAuto.hidden = !auto;
    if (statusMsg) statusMsg.hidden = true;
    if (auto) {
      definirDatetimePadrao(autoInicio, 0);
      atualizarPlanoAuto();
      carregarMonitores();
    } else {
      irPasso(1);
    }
  }

  function atualizarPlanoAuto() {
    if (!autoPlano) return;
    var qtd = parseInt(document.getElementById('ia-auto-qtd')?.value, 10) || 1;
    var min = parseInt(document.getElementById('ia-auto-intervalo')?.value, 10) || 30;
    var palavras = autoPalavras?.value?.trim() || 'gospel';
    var termo = palavras.split(',')[0].trim();
    var inicio = autoInicio?.value ? formatarDataHoraLocal(autoInicio.value) : 'agora';
    var fim = autoFim?.value ? formatarDataHoraLocal(autoFim.value) : 'sem limite';
    autoPlano.textContent = 'A cada ' + formatarTempo(min) + ', buscar até ' + qtd + ' assunto(s) recente(s) sobre "' + termo + '" e publicar automaticamente (' + inicio + ' → ' + fim + ').';
  }

  async function carregarMonitores() {
    if (!autoLista) return;
    try {
      var res = await fetch('/admin/posts/ia/monitor-lista', { headers: { Accept: 'application/json' } });
      var data = await res.json();
      if (!data.ok) return;
      var monitores = data.monitores || [];
      if (!monitores.length) {
        if (autoListaWrap) autoListaWrap.hidden = true;
        return;
      }
      if (autoListaWrap) autoListaWrap.hidden = false;
      autoLista.innerHTML = '';
      monitores.forEach(function (m) {
        var item = document.createElement('div');
        item.className = 'ia-auto-item ia-auto-item--' + m.status;
        var statusLabel = { ativo: 'Ativa', pausado: 'Pausada', concluido: 'Concluída', cancelado: 'Cancelada' }[m.status] || m.status;
        item.innerHTML =
          '<div class="ia-auto-item-corpo">' +
          '<strong>' + escapar(m.palavrasChave) + '</strong>' +
          '<span class="ia-auto-item-meta">' + statusLabel +
          ' · ' + m.quantidadePorCiclo + '/ciclo · a cada ' + formatarTempo(m.minutosIntervalo) +
          ' · ' + (m.totalPublicados || 0) + ' publicada(s)' +
          (m.proximaExecucao && m.status === 'ativo' ? ' · próxima: ' + formatarDataHoraLocal(m.proximaExecucao) : '') +
          (m.ultimoErro && m.status === 'ativo' ? ' · <em>' + escapar(m.ultimoErro) + '</em>' : '') +
          '</span></div>' +
          '<div class="ia-auto-item-acoes">' +
          (m.status === 'ativo'
            ? '<button type="button" class="btn btn-sec btn-sm" data-acao="pausar" data-id="' + m.id + '">Pausar</button>'
            : (m.status === 'pausado'
              ? '<button type="button" class="btn btn-sec btn-sm" data-acao="retomar" data-id="' + m.id + '">Retomar</button>'
              : '')) +
          (m.status === 'ativo' || m.status === 'pausado'
            ? '<button type="button" class="btn btn-perigo btn-sm" data-acao="cancelar" data-id="' + m.id + '">Cancelar</button>'
            : '') +
          '</div>';
        autoLista.appendChild(item);
      });
    } catch (e) { /* ignore */ }
  }

  async function acaoMonitor(acao, id) {
    var urls = {
      cancelar: '/admin/posts/ia/monitor-cancelar',
      pausar: '/admin/posts/ia/monitor-pausar',
      retomar: '/admin/posts/ia/monitor-retomar'
    };
    var data = await chamarApi(urls[acao], { id: id });
    mostrarStatus(data.mensagem || 'Atualizado.', 'sucesso');
    carregarMonitores();
  }

  if (modoBuscaRadios.length) {
    modoBuscaRadios.forEach(function (r) {
      r.addEventListener('change', atualizarModoBusca);
    });
  }
  ['ia-auto-qtd', 'ia-auto-intervalo', 'ia-auto-palavras', 'ia-auto-dias'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('change', atualizarPlanoAuto);
      el.addEventListener('input', atualizarPlanoAuto);
    }
  });
  if (autoInicio) autoInicio.addEventListener('change', atualizarPlanoAuto);
  if (autoFim) autoFim.addEventListener('change', atualizarPlanoAuto);

  if (autoLista) {
    autoLista.addEventListener('click', async function (e) {
      var btn = e.target.closest('[data-acao]');
      if (!btn) return;
      var acao = btn.dataset.acao;
      var id = parseInt(btn.dataset.id, 10);
      if (!id) return;
      if (acao === 'cancelar' && !confirm('Cancelar esta automação?')) return;
      try {
        await acaoMonitor(acao, id);
      } catch (err) {
        mostrarStatus(err.message, 'erro');
      }
    });
  }

  if (btnAutoIniciar) {
    btnAutoIniciar.addEventListener('click', async function () {
      var palavras = autoPalavras?.value?.trim();
      if (!palavras) {
        mostrarStatus('Informe o assunto que deseja monitorar.', 'erro');
        autoPalavras?.focus();
        return;
      }
      if (!autoInicio?.value) {
        mostrarStatus('Informe a data de início.', 'erro');
        return;
      }
      if (autoFim?.value && new Date(autoFim.value) <= new Date(autoInicio.value)) {
        mostrarStatus('A data de fim deve ser posterior ao início.', 'erro');
        return;
      }
      var termo = palavras.split(',')[0].trim();
      var msg = 'Ativar automação para "' + termo + '"?\n\nO servidor vai buscar assuntos recentes e publicar automaticamente nos intervalos definidos. Você pode fechar esta página.';
      if (!confirm(msg)) return;
      setCarregando(btnAutoIniciar, true);
      try {
        var payload = Object.assign({
          palavrasChave: palavras,
          categoriaId: document.getElementById('ia-auto-categoria')?.value || null,
          status: document.getElementById('ia-auto-status')?.value || 'publicado',
          quantidadePorCiclo: document.getElementById('ia-auto-qtd')?.value || 1,
          minutosIntervalo: document.getElementById('ia-auto-intervalo')?.value || 30,
          inicioEm: new Date(autoInicio.value).toISOString(),
          fimEm: autoFim?.value ? new Date(autoFim.value).toISOString() : null
        }, opcoesBuscaAuto());
        var data = await chamarApi('/admin/posts/ia/monitor-criar', payload);
        mostrarStatus(data.mensagem, 'sucesso');
        carregarMonitores();
        setTimeout(function () {
          window.location.href = '/admin/posts?monitor=1';
        }, 1500);
      } catch (e) {
        mostrarStatus(e.message, 'erro');
      } finally {
        setCarregando(btnAutoIniciar, false, 'Iniciar automação');
      }
    });
  }

  document.querySelectorAll('.tag-rapida-auto').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!autoPalavras) return;
      var tags = autoPalavras.value.split(/[,;]/).map(function (t) { return t.trim(); }).filter(Boolean);
      if (tags.indexOf(btn.dataset.tag) === -1) tags.push(btn.dataset.tag);
      autoPalavras.value = tags.join(', ');
      atualizarPlanoAuto();
    });
  });

  function escapar(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }

  function atualizarSelecionarTodos() {
    if (!selecionarTodos) return;
    var habilitados = document.querySelectorAll('.ia-topico-check:not(:disabled)');
    var marcados = document.querySelectorAll('.ia-topico-check:not(:disabled):checked');
    selecionarTodos.checked = habilitados.length > 0 && marcados.length === habilitados.length;
    selecionarTodos.disabled = habilitados.length === 0;
  }

  function renderizarTopicos(topicos) {
    topicosEncontrados = topicos;
    listaTopicos.innerHTML = '';
    var novos = 0;
    topicos.forEach(function (t, i) {
      var jaPub = !!t.jaPublicado;
      if (!jaPub) novos++;
      var label = document.createElement('label');
      label.className = 'ia-topico-item' + (jaPub ? ' ia-topico-item--publicado' : '');
      label.innerHTML = '<input type="checkbox" class="ia-topico-check" data-index="' + i + '"' +
        (jaPub ? ' disabled' : ' checked') + '>' +
        '<div><strong>' + escapar(t.titulo) + '</strong>' +
        '<span class="ia-topico-meta">' + escapar(t.nicho || '') +
        (t.emAlta ? ' · <em class="ia-em-alta">em alta</em>' : '') +
        (t.recente !== false ? ' · <span class="ia-badge-recente">recente</span>' : '') +
        (t.fonteInternacional ? ' · <span class="ia-badge-internacional">internacional</span>' : '') +
        (t.redeSocial ? ' · <span class="ia-badge-rede">' + escapar(t.redeSocial) + '</span>' : (t.fonte ? ' · ' + escapar(t.fonte) : '')) +
        (t.veiculo ? ' · ' + escapar(t.veiculo) : '') +
        (jaPub ? ' · <span class="ia-badge-publicado">Já publicado</span>' : '') +
        (jaPub && t.postExistente ? ' · <a href="/admin/posts/' + t.postExistente.id + '/editar" class="ia-link-post" onclick="event.stopPropagation()">Ver matéria</a>' : '') +
        '</span>' +
        (t.resumo ? '<p class="ia-topico-resumo">' + escapar(t.resumo) + '</p>' : '') + '</div>';
      listaTopicos.appendChild(label);
    });
    atualizarSelecionarTodos();
    var msg = topicos.length + ' tópico(s) encontrado(s)';
    if (novos < topicos.length) msg += ' · ' + (topicos.length - novos) + ' já publicado(s), não podem ser gerados novamente';
    mostrarStatus(msg, novos ? 'sucesso' : 'aviso');
    irPasso(2);
  }

  function topicosSelecionados() {
    return Array.from(document.querySelectorAll('.ia-topico-check:checked:not(:disabled)'))
      .map(function (cb) { return topicosEncontrados[parseInt(cb.dataset.index, 10)]; })
      .filter(function (t) { return t && !t.jaPublicado; });
  }

  function preencherFormulario(artigo) {
    titulo.value = artigo.titulo || '';
    slug.value = '';
    slugEditado = false;
    resumo.value = artigo.resumo || '';
    definirConteudoEditor(artigo.conteudo || '');
    var mt = document.getElementById('meta-title');
    var md = document.getElementById('meta-desc');
    if (mt) { mt.value = artigo.meta_title || ''; mt.dispatchEvent(new Event('input')); }
    if (md) { md.value = artigo.meta_description || ''; md.dispatchEvent(new Event('input')); }
    titulo.dispatchEvent(new Event('input'));
    resumo.dispatchEvent(new Event('input'));
    var catIa = document.getElementById('ia-categoria').value;
    if (catIa) document.querySelector('[name="categoriaId"]').value = catIa;
    if (artigo.imagem) {
      mostrarImagem(artigo.imagem);
      document.getElementById('imagem-ia-url').value = artigo.imagem;
    } else {
      document.getElementById('imagem-ia-url').value = '';
      var avisoSem = document.getElementById('aviso-sem-capa');
      if (avisoSem) avisoSem.hidden = false;
      if (statusSelect) {
        statusSelect.value = 'rascunho';
        statusSelect.dispatchEvent(new Event('change'));
      }
    }
    var altIa = document.getElementById('imagem-alt-ia');
    if (altIa) altIa.value = artigo.imagemAlt || artigo.imagem_alt || '';
    modoTabs[0].click();
    mostrarStatus('Matéria gerada! Revise o texto e a capa antes de publicar.', 'sucesso');
    formPost.scrollIntoView({ behavior: 'smooth' });
  }

  btnPesquisar.addEventListener('click', async function () {
    setCarregando(btnPesquisar, true);
    var busca = opcoesBuscaIa();
    mostrarStatus(
      busca.somenteRedesSociais ? 'Buscando assuntos nas redes sociais (24h)...' : 'Buscando tópicos na internet...',
      'info'
    );
    try {
      var data = await chamarApi('/admin/posts/ia/pesquisar', Object.assign({
        palavrasChave: document.getElementById('ia-palavras').value,
        quantidadePorNicho: document.getElementById('ia-quantidade').value
      }, opcoesBuscaIa()));
      renderizarTopicos(data.topicos);
    } catch (e) { mostrarStatus(e.message, 'erro'); }
    finally { setCarregando(btnPesquisar, false, 'Buscar assuntos'); }
  });

  document.getElementById('btn-ia-voltar-1').addEventListener('click', function () { irPasso(1); });
  document.getElementById('btn-ia-continuar-2').addEventListener('click', function () {
    if (!topicosSelecionados().length) { mostrarStatus('Selecione ao menos um tópico.', 'erro'); return; }
    atualizarResumoPublicacao();
    irPasso(3);
  });
  document.getElementById('btn-ia-voltar-2').addEventListener('click', function () {
    if (publicacaoAtiva) return;
    irPasso(2);
  });

  var modoPubRadios = document.querySelectorAll('input[name="ia-modo-pub"]');
  var intervaloConfig = document.getElementById('ia-intervalo-config');
  var resumoSelecao = document.getElementById('ia-resumo-selecao');
  var planoPublicacao = document.getElementById('ia-plano-publicacao');
  var progressoEl = document.getElementById('ia-progresso');
  var progressoFill = document.getElementById('ia-progresso-fill');
  var progressoTexto = document.getElementById('ia-progresso-texto');
  var btnCancelar = document.getElementById('btn-ia-cancelar');
  var publicacaoAtiva = false;
  var cancelarPublicacao = false;

  function sleep(ms) {
    return new Promise(function (resolve) { setTimeout(resolve, ms); });
  }

  function formatarTempo(minutos) {
    if (minutos >= 60) return (minutos / 60) + ' h';
    return minutos + ' min';
  }

  function atualizarResumoPublicacao() {
    var sel = topicosSelecionados();
    if (resumoSelecao) {
      resumoSelecao.innerHTML = sel.length
        ? '<strong>' + sel.length + '</strong> matéria(s) pronta(s) para gerar'
        : 'Nenhuma matéria selecionada.';
    }
    atualizarPlanoPublicacao();
  }

  function atualizarPlanoPublicacao() {
    if (!planoPublicacao) return;
    var sel = topicosSelecionados();
    var total = sel.length;
    if (!total) {
      planoPublicacao.textContent = '';
      return;
    }
    var modoIntervalo = document.querySelector('input[name="ia-modo-pub"]:checked')?.value === 'intervalos';
    if (!modoIntervalo) {
      planoPublicacao.textContent = total === 1 ? '1 matéria será gerada agora.' : total + ' matérias em sequência.';
      return;
    }
    var porLote = parseInt(document.getElementById('ia-qtd-intervalo').value, 10) || 1;
    var minutos = parseInt(document.getElementById('ia-min-intervalo').value, 10) || 15;
    var lotes = Math.ceil(total / porLote);
    var pausas = Math.max(lotes - 1, 0);
    var modoInicio = document.getElementById('ia-inicio-modo')?.value || 'agora';
    var inicioTxt = modoInicio === 'apos_fila' && slotFilaCache?.sugeridoAposFila
      ? ' a partir de ' + formatarDataHoraLocal(slotFilaCache.sugeridoAposFila)
      : (modoInicio === 'custom' && document.getElementById('ia-inicio-custom')?.value
        ? ' a partir de ' + formatarDataHoraLocal(document.getElementById('ia-inicio-custom').value)
        : '');
    planoPublicacao.textContent = total + ' matéria(s) em ' + lotes + ' lote(s) de até ' + porLote +
      ', intervalo de ' + formatarTempo(minutos) + ' no servidor (' + pausas + ' pausa(s))' + inicioTxt + '. Pode fechar a página.';
  }

  modoPubRadios.forEach(function (radio) {
    radio.addEventListener('change', function () {
      var intervalo = radio.value === 'intervalos' && radio.checked;
      if (intervaloConfig) intervaloConfig.hidden = !intervalo;
      if (intervalo) {
        carregarProximoSlotFila().then(function () { atualizarInicioIntervalo(); });
      }
      atualizarPlanoPublicacao();
    });
  });
  document.getElementById('ia-qtd-intervalo').addEventListener('change', atualizarPlanoPublicacao);
  document.getElementById('ia-min-intervalo').addEventListener('change', function () {
    carregarProximoSlotFila().then(function () { atualizarInicioIntervalo(); });
    atualizarPlanoPublicacao();
  });
  var inicioModo = document.getElementById('ia-inicio-modo');
  var inicioCustom = document.getElementById('ia-inicio-custom');
  if (inicioModo) inicioModo.addEventListener('change', atualizarInicioIntervalo);
  if (inicioCustom) inicioCustom.addEventListener('change', atualizarPlanoPublicacao);

  function atualizarProgresso(atual, total, texto) {
    if (!progressoEl) return;
    progressoEl.hidden = false;
    var pct = total ? Math.round((atual / total) * 100) : 0;
    if (progressoFill) progressoFill.style.width = pct + '%';
    if (progressoTexto) progressoTexto.textContent = texto;
  }

  function opcoesPublicacao() {
    return {
      categoriaId: document.getElementById('ia-categoria').value || null,
      status: document.getElementById('ia-status').value,
      destaque: false
    };
  }

  async function agendarFilaApi(topicos) {
    var opts = opcoesPublicacao();
    var porLote = parseInt(document.getElementById('ia-qtd-intervalo').value, 10) || 1;
    var minutos = parseInt(document.getElementById('ia-min-intervalo').value, 10) || 5;
    var modoInicio = document.getElementById('ia-inicio-modo')?.value || 'agora';
    var payload = {
      topicos: topicos,
      categoriaId: opts.categoriaId,
      status: opts.status,
      porLote: porLote,
      minutosIntervalo: minutos,
      modoInicio: modoInicio
    };
    if (modoInicio === 'custom') {
      var val = document.getElementById('ia-inicio-custom')?.value;
      if (!val) throw new Error('Informe a data e hora de início.');
      payload.inicioEm = new Date(val).toISOString();
    }
    return chamarApi('/admin/posts/ia/agendar-fila', Object.assign(payload, opcoesBuscaIa()));
  }

  async function agendarTopicosNaFila(sel) {
    mostrarStatus('Agendando ' + sel.length + ' matéria(s) na fila do servidor...', 'info');
    try {
      var data = await agendarFilaApi(sel);
      mostrarStatus(data.mensagem, 'sucesso');
      setTimeout(function () {
        window.location.href = '/admin/posts?fila=1';
      }, 1200);
    } catch (e) {
      mostrarStatus(e.message, 'erro');
      throw e;
    }
  }

  async function gerarLoteApi(topicos) {
    var opts = opcoesPublicacao();
    return chamarApi('/admin/posts/ia/gerar-lote', {
      topicos: topicos,
      categoriaId: opts.categoriaId,
      status: opts.status,
      destaque: opts.destaque
    });
  }

  async function publicarTopicos(sel) {
    var porLote = 5;
    var total = sel.length;
    var criados = [];
    var erros = [];
    var ignorados = 0;
    var rascunhosSemImagem = 0;
    var processados = 0;

    publicacaoAtiva = true;
    cancelarPublicacao = false;
    if (btnCancelar) btnCancelar.hidden = false;
    btnLote.disabled = true;
    document.getElementById('btn-ia-voltar-2').disabled = true;

    for (var i = 0; i < sel.length; i += porLote) {
      if (cancelarPublicacao) break;
      var lote = sel.slice(i, i + porLote);
      var fim = Math.min(i + porLote, total);
      atualizarProgresso(processados, total, 'Gerando matérias ' + (i + 1) + '–' + fim + ' de ' + total + '...');
      mostrarStatus('Gerando lote ' + (Math.floor(i / porLote) + 1) + ': matérias ' + (i + 1) + ' a ' + fim + ' de ' + total + '...', 'info');

      try {
        var data = await gerarLoteApi(lote);
        criados = criados.concat(data.criados || []);
        erros = erros.concat(data.erros || []);
        ignorados += data.ignorados || 0;
        rascunhosSemImagem += data.rascunhosSemImagem || 0;
        processados = Math.min(fim, total);
        atualizarProgresso(processados, total, processados + ' de ' + total + ' matéria(s) processada(s).');
      } catch (e) {
        erros.push({ titulo: lote[0]?.titulo || 'Lote', erro: e.message });
        processados = Math.min(fim, total);
      }

      if (cancelarPublicacao || i + porLote >= sel.length) break;
    }

    publicacaoAtiva = false;
    if (btnCancelar) btnCancelar.hidden = true;
    btnLote.disabled = false;
    document.getElementById('btn-ia-voltar-2').disabled = false;

    var msg = cancelarPublicacao
      ? 'Publicação cancelada. ' + criados.length + ' matéria(s) gerada(s) antes do cancelamento.'
      : criados.length + ' matéria(s) criada(s)' +
        (ignorados ? ', ' + ignorados + ' ignorada(s)' : '') +
        (rascunhosSemImagem ? ', ' + rascunhosSemImagem + ' salva(s) como rascunho por falta de imagem' : '') +
        (erros.length ? ', ' + erros.length + ' com erro' : '') + '.';

    mostrarStatus(msg, erros.length || cancelarPublicacao ? 'aviso' : 'sucesso');

    if (criados.length === 1) {
      window.location.href = '/admin/posts/' + criados[0].id + '/editar';
    } else if (criados.length > 0 && !cancelarPublicacao) {
      setTimeout(function () { window.location.href = '/admin/posts'; }, 2500);
    }
  }

  if (btnCancelar) {
    btnCancelar.addEventListener('click', function () {
      if (publicacaoAtiva && confirm('Cancelar a publicação? O lote atual termina; os próximos não serão gerados.')) {
        cancelarPublicacao = true;
      }
    });
  }

  btnUma.addEventListener('click', async function () {
