<div class="page-header">
  <div>
    <h1>Posts</h1>
    <p class="page-subtitulo">Gerencie os artigos do site</p>
  </div>
  <a href="/admin/posts/novo" class="btn btn-primario btn-com-icone">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Novo post
  </a>
</div>

<% if (typeof monitorIa !== 'undefined' && monitorIa && monitorIa.temAtivos) { %>
<div class="fila-ia-banner fila-ia-banner--monitor" id="monitor-ia-banner">
  <div class="fila-ia-banner-texto">
    <strong>Automação de IA ativa</strong>
    <span id="monitor-ia-detalhe"><%= monitorIa.ativos %> monitor(es) buscando assuntos recentes e publicando automaticamente.</span>
    <span class="dica">Configure em Novo post → Gerar com IA → Automação contínua.</span>
  </div>
  <a href="/admin/posts/novo?auto=1" class="btn btn-sec">Ver automações</a>
</div>
<% } %>

<% if (typeof filaIa !== 'undefined' && filaIa && filaIa.ativo) { %>
<div class="fila-ia-banner" id="fila-ia-banner">
  <div class="fila-ia-banner-texto">
    <strong>Fila de IA ativa</strong>
    <span id="fila-ia-detalhe"><%= filaIa.pendentes %> pendente(s) · <%= filaIa.concluidos %> concluída(s)<% if (filaIa.erros) { %> · <%= filaIa.erros %> erro(s)<% } %><% if (filaIa.cancelados) { %> · <%= filaIa.cancelados %> ignorado(s)<% } %><% if (filaIa.processando) { %> · gerando agora<% } %></span>
    <span class="dica">O servidor gera e publica automaticamente — não precisa manter a página aberta.</span>
  </div>
  <button type="button" class="btn btn-sec" id="btn-cancelar-fila">Cancelar pendentes</button>
</div>
<% } %>

<% if (typeof filaIa !== 'undefined' && filaIa && filaIa.erros > 0) { %>
<div class="fila-ia-erros" id="fila-ia-erros">
  <div class="fila-ia-erros-topo">
    <strong>Últimos erros da fila de IA</strong>
    <div class="fila-ia-erros-acoes">
      <button type="button" class="btn btn-sec btn-sm" id="btn-limpar-erros-fila">Arquivar erros antigos</button>
    </div>
  </div>
  <ul class="fila-ia-erros-lista" id="fila-ia-erros-lista">
    <% (filaErrosRecentes || []).forEach(function (item) { %>
      <li>
        <span class="fila-ia-erro-titulo"><%= item.titulo || 'Sem título' %></span>
        <span class="fila-ia-erro-msg"><%= item.erro %></span>
      </li>
    <% }) %>
  </ul>
  <p class="dica fila-ia-erros-dica">Causas comuns: cota do Brave esgotada, Serper gratuito sem <code>site:</code>, assunto duplicado ou falha na API DeepSeek. Sem capa vira rascunho — não conta como erro.</p>
</div>
<% } %>

<div class="posts-toolbar">
  <div class="posts-filtros">
    <button type="button" class="filtro-btn ativo" data-filtro="todos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      Todos
    </button>
    <button type="button" class="filtro-btn" data-filtro="publicado">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      Publicados
    </button>
    <button type="button" class="filtro-btn" data-filtro="rascunho">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Rascunhos
    </button>
    <button type="button" class="filtro-btn" data-filtro="agendado">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Agendados
    </button>
  </div>
  <label class="posts-busca">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" id="posts-busca" placeholder="Buscar por título..." autocomplete="off">
  </label>
</div>

<div class="posts-acoes-lote" id="posts-acoes-lote" hidden>
  <span id="posts-selecao-contagem">0 selecionado(s)</span>
  <button type="button" class="btn btn-perigo btn-sm" id="btn-excluir-lote">Excluir selecionados</button>
  <button type="button" class="btn btn-sec btn-sm" id="btn-limpar-selecao">Limpar seleção</button>
</div>

<form id="form-excluir-lote" action="/admin/posts/excluir-lote" method="post" hidden>
  <div id="form-excluir-lote-ids"></div>
  <input type="hidden" name="redirectStatus" id="form-excluir-lote-status" value="">
</form>

<% if (!posts.length) { %>
  <div class="posts-vazio">
    <p>Nenhum post encontrado.</p>
    <a href="/admin/posts/novo" class="btn btn-primario btn-com-icone">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Criar post
    </a>
  </div>
<% } else { %>
  <div class="posts-lista-simples" id="posts-lista">
    <div class="posts-lista-cabecalho">
      <span class="post-col-check">
        <input type="checkbox" id="posts-selecionar-todos" title="Selecionar visíveis" aria-label="Selecionar todos visíveis">
      </span>
      <span>Título</span>
      <span>Categoria</span>
      <span>Autor</span>
      <span>Data</span>
      <span>Status</span>
      <span>Ações</span>
    </div>
    <% posts.forEach(function (post) {
      const dataPost = post.publicadoEm || post.createdAt;
      const ehAgendado = post.status === 'agendado' && post.publicadoEm;
      const dataFmt = dataPost
        ? (ehAgendado
          ? 'Agendado: ' + new Date(dataPost).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })
          : new Date(dataPost).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }))
        : '-';
      const statusLabel = post.status === 'agendado' ? 'Agendado' : post.status;
    %>
    <div class="post-linha" data-status="<%= post.status %>" data-titulo="<%= post.titulo.toLowerCase() %>" data-id="<%= post.id %>">
      <span class="post-col-check">
        <input type="checkbox" class="post-check" value="<%= post.id %>" aria-label="Selecionar <%= post.titulo %>">
      </span>
      <span class="post-linha-titulo">
        <a href="/admin/posts/<%= post.id %>/editar"><%= post.titulo %></a>
        <% if (post.destaque) { %>
          <span class="post-destaque" title="Em destaque">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </span>
        <% } %>
      </span>
      <span class="post-linha-categoria"><%= post.categoria ? post.categoria.nome : '—' %></span>
      <span class="post-linha-autor"><%= post.autor ? post.autor.nome : '—' %></span>
      <span class="post-linha-data"><%= dataFmt %></span>
      <span class="post-linha-status"><span class="badge badge-<%= post.status %>"><%= statusLabel %></span></span>
      <span class="post-linha-acoes">
        <a href="/admin/posts/<%= post.id %>/editar" class="btn-icone" title="Editar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </a>
        <% if (post.status === 'publicado') { %>
          <a href="/post/<%= post.slug %>" target="_blank" rel="noopener" class="btn-icone" title="Ver no site">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        <% } %>
        <form action="/admin/posts/<%= post.id %>/excluir" method="post" class="form-excluir-post" onsubmit="return confirm('Excluir este post?')">
          <input type="hidden" name="redirectStatus" class="input-redirect-status" value="">
          <button type="submit" class="btn-icone btn-icone-perigo" title="Excluir">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </form>
      </span>
    </div>
    <% }) %>
  </div>
  <p class="posts-contador" id="posts-contador"><%= posts.length %> post<%= posts.length !== 1 ? 's' : '' %></p>
<% } %>

<script>
  (function () {
    var filtroAtual = 'todos';
    var buscaInput = document.getElementById('posts-busca');
    var lista = document.getElementById('posts-lista');
    var contador = document.getElementById('posts-contador');
    var chkTodos = document.getElementById('posts-selecionar-todos');
    var barraLote = document.getElementById('posts-acoes-lote');
    var contagemLote = document.getElementById('posts-selecao-contagem');
    var btnExcluirLote = document.getElementById('btn-excluir-lote');
    var btnLimparSelecao = document.getElementById('btn-limpar-selecao');
    var formExcluirLote = document.getElementById('form-excluir-lote');
    var containerIdsLote = document.getElementById('form-excluir-lote-ids');
    var inputStatusLote = document.getElementById('form-excluir-lote-status');
    if (!lista) return;

    function atualizarUrlFiltro() {
      var params = new URLSearchParams(window.location.search);
      if (filtroAtual === 'todos') {
        params.delete('status');
      } else {
        params.set('status', filtroAtual);
      }
      var qs = params.toString();
      var url = window.location.pathname + (qs ? '?' + qs : '');
      history.replaceState(null, '', url);
    }

    function atualizarRedirects() {
      document.querySelectorAll('.input-redirect-status').forEach(function (input) {
        input.value = filtroAtual;
      });
      if (inputStatusLote) inputStatusLote.value = filtroAtual;
    }

    function linhasVisiveis() {
      return Array.from(lista.querySelectorAll('.post-linha')).filter(function (item) {
        return !item.hidden;
      });
    }

    function selecionados() {
      return Array.from(lista.querySelectorAll('.post-check:checked'));
    }

    function atualizarBarraLote() {
      var qtd = selecionados().length;
      if (barraLote) barraLote.hidden = qtd === 0;
      if (contagemLote) contagemLote.textContent = qtd + ' selecionado' + (qtd !== 1 ? 's' : '');
      if (chkTodos) {
        var visiveis = linhasVisiveis();
        var marcadosVisiveis = visiveis.filter(function (linha) {
          return linha.querySelector('.post-check')?.checked;
        });
        chkTodos.checked = visiveis.length > 0 && marcadosVisiveis.length === visiveis.length;
        chkTodos.indeterminate = marcadosVisiveis.length > 0 && marcadosVisiveis.length < visiveis.length;
      }
    }

    function aplicarFiltros() {
      var termo = buscaInput ? buscaInput.value.trim().toLowerCase() : '';
      var visiveis = 0;
      lista.querySelectorAll('.post-linha').forEach(function (item) {
        var okStatus = filtroAtual === 'todos' || item.dataset.status === filtroAtual;
        var okBusca = !termo || (item.dataset.titulo || '').includes(termo);
        var mostrar = okStatus && okBusca;
        item.hidden = !mostrar;
        if (mostrar) visiveis++;
      });
      if (contador) contador.textContent = visiveis + ' post' + (visiveis !== 1 ? 's' : '');
      atualizarBarraLote();
    }

    function ativarFiltro(filtro) {
      filtroAtual = filtro;
      document.querySelectorAll('.filtro-btn').forEach(function (b) {
        b.classList.toggle('ativo', b.dataset.filtro === filtro);
      });
      atualizarRedirects();
      atualizarUrlFiltro();
      aplicarFiltros();
    }

    document.querySelectorAll('.filtro-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        ativarFiltro(btn.dataset.filtro);
      });
    });

    if (buscaInput) buscaInput.addEventListener('input', aplicarFiltros);

    lista.addEventListener('change', function (e) {
      if (e.target.classList.contains('post-check')) {
        var linha = e.target.closest('.post-linha');
        if (linha) linha.classList.toggle('post-linha--selecionada', e.target.checked);
        atualizarBarraLote();
      }
    });

    if (chkTodos) {
      chkTodos.addEventListener('change', function () {
        linhasVisiveis().forEach(function (linha) {
          var chk = linha.querySelector('.post-check');
          if (chk) chk.checked = chkTodos.checked;
        });
        atualizarBarraLote();
      });
    }

    if (btnLimparSelecao) {
      btnLimparSelecao.addEventListener('click', function () {
        lista.querySelectorAll('.post-check').forEach(function (chk) { chk.checked = false; });
        atualizarBarraLote();
      });
    }

    if (btnExcluirLote && formExcluirLote && containerIdsLote) {
      btnExcluirLote.addEventListener('click', function () {
        var ids = selecionados().map(function (chk) { return chk.value; });
        if (!ids.length) return;
        var msg = ids.length === 1
          ? 'Excluir 1 post selecionado?'
          : 'Excluir ' + ids.length + ' posts selecionados?';
        if (!confirm(msg)) return;
        containerIdsLote.innerHTML = '';
        ids.forEach(function (id) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'ids';
          input.value = id;
          containerIdsLote.appendChild(input);
        });
        if (inputStatusLote) inputStatusLote.value = filtroAtual;
        formExcluirLote.submit();
      });
    }

    document.querySelectorAll('.form-excluir-post').forEach(function (form) {
      form.addEventListener('submit', function () {
        var input = form.querySelector('.input-redirect-status');
        if (input) input.value = filtroAtual;
      });
    });

    var params = new URLSearchParams(window.location.search);
    if (params.get('fila') === '1') {
      ativarFiltro('agendado');
    } else if (params.get('status')) {
      var statusParam = params.get('status');
      var btnStatus = document.querySelector('.filtro-btn[data-filtro="' + statusParam + '"]');
      if (btnStatus) ativarFiltro(statusParam);
    } else {
      atualizarRedirects();
      aplicarFiltros();
    }

    var banner = document.getElementById('fila-ia-banner');
    var detalhe = document.getElementById('fila-ia-detalhe');
    var btnCancelarFila = document.getElementById('btn-cancelar-fila');

    function atualizarBannerFila(data) {
      if (!detalhe) return;
      var txt = data.pendentes + ' pendente(s) · ' + data.concluidos + ' concluída(s)';
      if (data.erros) txt += ' · ' + data.erros + ' erro(s)';
      if (data.cancelados) txt += ' · ' + data.cancelados + ' ignorado(s)';
      if (data.processando) txt += ' · gerando agora';
      detalhe.textContent = txt;
      if (!data.ativo && banner) {
        banner.classList.add('fila-ia-banner--concluida');
        if (btnCancelarFila) btnCancelarFila.hidden = true;
        setTimeout(function () { window.location.reload(); }, 2000);
      }
    }

    async function pollFila() {
      try {
        var res = await fetch('/admin/posts/ia/fila-status');
        var data = await res.json();
        if (data.ok) atualizarBannerFila(data);
      } catch (e) { /* silencioso */ }
    }

    if (banner || params.get('fila') === '1') {
      pollFila();
      setInterval(pollFila, 30000);
    }

    if (btnCancelarFila) {
      btnCancelarFila.addEventListener('click', async function () {
        if (!confirm('Cancelar todas as matérias pendentes na fila?')) return;
        btnCancelarFila.disabled = true;
        try {
          var res = await fetch('/admin/posts/ia/fila-cancelar', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          var data = await res.json();
          if (!data.ok) throw new Error(data.erro || 'Erro ao cancelar');
          pollFila();
          btnCancelarFila.textContent = 'Cancelado';
        } catch (e) {
          alert(e.message);
          btnCancelarFila.disabled = false;
        }
      });
    }

    var btnLimparErros = document.getElementById('btn-limpar-erros-fila');
    if (btnLimparErros) {
      btnLimparErros.addEventListener('click', async function () {
        if (!confirm('Arquivar erros da fila com mais de 7 dias?')) return;
        btnLimparErros.disabled = true;
        try {
          var res = await fetch('/admin/posts/ia/fila-limpar-erros', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          var data = await res.json();
          if (!data.ok) throw new Error(data.erro || 'Erro ao limpar');
          alert(data.mensagem || 'Concluído.');
          window.location.reload();
        } catch (e) {
          alert(e.message);
          btnLimparErros.disabled = false;
        }
      });
    }
  })();
</script>
