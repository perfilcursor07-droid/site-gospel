<h1><%= categoria ? 'Editar categoria' : 'Nova categoria' %></h1>
<form action="<%= categoria ? '/admin/categorias/' + categoria.id : '/admin/categorias' %>" method="post" class="form">
  <label>Nome
    <input type="text" name="nome" value="<%= categoria ? categoria.nome : '' %>" required>
  </label>
  <label>Descrição
    <textarea name="descricao" rows="3"><%= categoria ? (categoria.descricao || '') : '' %></textarea>
  </label>
  <label>Cor de destaque
    <input type="color" name="cor_hex" value="<%= categoria ? (categoria.corHex || '#ea580c') : '#ea580c' %>" class="input-cor">
  </label>
  <p class="dica">Usada nos títulos de seção, no menu e nos cards do site.</p>
  <label>Ordem de exibição no menu
    <input type="number" name="ordem" min="0" value="<%= categoria ? categoria.ordem : 0 %>">
  </label>
  <div class="form-acoes">
    <button class="btn btn-primario">Salvar</button>
    <a href="/admin/categorias" class="btn btn-sec">Cancelar</a>
  </div>
</form>
