<h1><%= categoria ? 'Editar categoria' : 'Nova categoria' %></h1>
<form action="<%= categoria ? '/admin/categorias/' + categoria.id : '/admin/categorias' %>" method="post" class="form">
  <label>Nome
    <input type="text" name="nome" id="campo-nome" value="<%= categoria ? categoria.nome : '' %>" required>
  </label>
  <label>Slug (URL)
    <div class="slug-box">
      <span class="slug-prefix">/categoria/</span>
      <input type="text" name="slug" id="campo-slug" value="<%= categoria ? categoria.slug : '' %>" placeholder="auto" class="slug-input">
    </div>
  </label>
  <p class="dica">Gerado automaticamente a partir do nome. Edite se precisar de uma URL específica (ex.: <code>colunistas</code>).</p>
  <label>Descrição
    <textarea name="descricao" rows="3"><%= categoria ? (categoria.descricao || '') : '' %></textarea>
  </label>
  <label>Cor de destaque
    <input type="color" name="cor_hex" value="<%= categoria ? (categoria.corHex || '#ea580c') : '#ea580c' %>" class="input-cor">
  </label>
  <p class="dica">Usada nos títulos de seção, no menu e nos cards do site.</p>
  <label>Ordem de exibição no menu
    <input type="number" name="ordem" min="0" value="<%= categoria ? categoria.ordem : 0 %>">
  </label>
  <div class="form-acoes">
    <button class="btn btn-primario">Salvar</button>
    <a href="/admin/categorias" class="btn btn-sec">Cancelar</a>
  </div>
</form>

<script>
  (function () {
    var nome = document.getElementById('campo-nome');
    var slug = document.getElementById('campo-slug');
    if (!nome || !slug) return;

    var slugEditado = slug.value !== '';

    function gerarSlug(texto) {
      return (texto || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    nome.addEventListener('input', function () {
      if (!slugEditado) slug.value = gerarSlug(nome.value);
    });

    slug.addEventListener('input', function () {
      slugEditado = slug.value.trim() !== '';
    });
  })();
</script>
