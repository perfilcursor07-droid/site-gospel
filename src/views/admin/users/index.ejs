<div class="page-header">
  <h1>Usuários</h1>
  <a href="/admin/usuarios/novo" class="btn btn-primario">+ Novo usuário</a>
</div>
<table class="tabela">
  <thead><tr><th>Nome</th><th>E-mail</th><th>Papel</th><th>Ações</th></tr></thead>
  <tbody>
    <% usuarios.forEach(function (usuario) { %>
    <tr>
      <td><%= usuario.nome %></td>
      <td><%= usuario.email %></td>
      <td><span class="badge"><%= usuario.papel %></span></td>
      <td class="acoes">
        <a href="/admin/usuarios/<%= usuario.id %>/editar" class="btn btn-sec">Editar</a>
        <% if (usuario.id !== usuarioLogado.id) { %>
        <form action="/admin/usuarios/<%= usuario.id %>/excluir" method="post" onsubmit="return confirm('Excluir este usuário?')">
          <button class="btn btn-perigo">Excluir</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
