{
  "name": "site-gospel",
  "version": "1.0.0",
  "description": "Site gospel com CMS próprio em Node.js + MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "node src/seed.js",
    "setup:python": "pip install -r scripts/requirements.txt",
    "google:indexar": "node scripts/google-indexing-enviar.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "google-auth-library": "^10.9.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "sequelize": "^6.37.3",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  }
}
